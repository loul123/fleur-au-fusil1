	{ Name = "Pâquerette", Cooldown = 0.35, Speed = 190, Damage = 20, Petals = 1, Spread = 0.6, PetalColor = Color3.fromRGB(255, 255, 255), HeartColor = Color3.fromRGB(255, 215, 0) },
