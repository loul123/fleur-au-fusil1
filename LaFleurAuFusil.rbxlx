---------------------------------------------------------------------------
-- Animations de pétales
--   Trail : "Rainbow" ou "Color" ; Sparkles : étincelles ; Orbit : nb de
--   mini-pétales en orbite ; Impact : "Burst" | "Hearts" | "Rain" ; Size : taille
---------------------------------------------------------------------------
Cosmetics.PetalEffects = {
	{ Id = "Simple", Name = "Pétale simple", Rarity = "Commune", Impact = "Burst" },
	{ Id = "Traine", Name = "Traînée florale", Rarity = "Rare", Trail = "Color", Impact = "Burst" },
	{ Id = "Etincelles", Name = "Étincelles", Rarity = "Rare", Sparkles = true, Impact = "Burst" },
	{ Id = "Tourbillon", Name = "Tourbillon", Rarity = "Epique", Orbit = 2, Impact = "Burst" },
	{ Id = "Coeurs", Name = "Pluie de cœurs", Rarity = "Epique", Trail = "Color", Impact = "Hearts" },
	{ Id = "ArcEnCiel", Name = "Arc-en-ciel", Rarity = "Legendaire", Trail = "Rainbow", Sparkles = true, Impact = "Rain", Size = 1.25 },
}

Cosmetics.Defaults = {
	WeaponSkin = "Classique",
	FlowerSkin = "MargueriteBlanche",
	PetalEffect = "Simple",
}

---------------------------------------------------------------------------
-- Sachets de graines (tirage aléatoire d'une fleur)
--   Price : coût en graines (solde dépensable) ; Odds : % par rareté (total 100)
--   Dans une rareté, chaque fleur a la même chance.
--   Doublon : remboursé en graines (Rarities[...].Refund).
---------------------------------------------------------------------------
Cosmetics.Packs = {
	{ Id = "Sachet", Name = "Sachet de graines", Price = 150, Color = Color3.fromRGB(120, 200, 90),
		Odds = { Commune = 55, PeuCommune = 25, Rare = 12, Epique = 5, Legendaire = 2, Mythique = 0.7, Divin = 0.2, Secret = 0.08, Transcendant = 0.019, Ultime = 0.001 } },
	{ Id = "SachetDore", Name = "Sachet doré", Price = 600, Color = Color3.fromRGB(255, 200, 60),
		Odds = { Rare = 70, Epique = 20, Legendaire = 7, Mythique = 2.2, Divin = 0.6, Secret = 0.15, Transcendant = 0.049, Ultime = 0.001 } },
}

function Cosmetics.GetPack(id)
	for _, pack in Cosmetics.Packs do
		if pack.Id == id then
			return pack
		end
	end
	return nil
end

-- Tire une fleur d'un sachet. Renvoie l'objet fleur (à appeler côté serveur).
function Cosmetics.RollPack(pack, rng)
	local r = rng or Random.new()
	local total = 0
	for _, pct in pack.Odds do
		total += pct
	end
	local roll = r:NextNumber() * total
	local chosen = Cosmetics.RarityOrder[1]
	-- du plus rare au plus courant pour que les petites probabilités restent exactes
	for i = #Cosmetics.RarityOrder, 1, -1 do
		local rarity = Cosmetics.RarityOrder[i]
		local pct = pack.Odds[rarity]
		if pct then
			if roll < pct then
				chosen = rarity
				break
			end
			roll -= pct
			chosen = rarity
		end
	end
	local pool = {}
	for _, flower in Cosmetics.FlowerSkins do
		if flower.Rarity == chosen then
			table.insert(pool, flower)
		end
	end
	return pool[r:NextInteger(1, #pool)]
end

local LISTS = {
	WeaponSkin = Cosmetics.WeaponSkins,
	FlowerSkin = Cosmetics.FlowerSkins,
	PetalEffect = Cosmetics.PetalEffects,
}
Cosmetics.Types = { "WeaponSkin", "FlowerSkin", "PetalEffect" }

local index = {}
for typeName, list in LISTS do
	index[typeName] = {}
	for _, item in list do
		item.Type = typeName
		index[typeName][item.Id] = item
	end
end

function Cosmetics.List(typeName)
	return LISTS[typeName] or {}
end

-- Renvoie l'objet demandé, ou l'objet par défaut de la catégorie si l'Id est inconnu
function Cosmetics.Get(typeName, id)
	local byId = index[typeName]
	if not byId then
		return nil
	end
	return byId[id] or byId[Cosmetics.Defaults[typeName]]
end

function Cosmetics.Exists(typeName, id)
	return index[typeName] ~= nil and index[typeName][id] ~= nil
end

function Cosmetics.Key(typeName, id)
	return typeName .. ":" .. id
end

function Cosmetics.IsDefault(typeName, id)
	return Cosmetics.Defaults[typeName] == id
end

-- Tenue complète : { WeaponSkin = Id, FlowerSkin = Id, PetalEffect = Id }
function Cosmetics.DefaultLook()
	return table.clone(Cosmetics.Defaults)
end

function Cosmetics.RandomLook(rng)
	local r = rng or Random.new()
	local look = {}
	for _, typeName in Cosmetics.Types do
		local list = LISTS[typeName]
		look[typeName] = list[r:NextInteger(1, #list)].Id
	end
	return look
end

return Cosmetics
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">PetalVisual</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Rendu des pétales côté client (ModuleScript)
	Emplacement : ReplicatedStorage > FleurShared > PetalVisual

	Purement visuel : les dégâts sont calculés par le serveur (CombatService).
	Le client simule la même trajectoire (vitesse + gravité) pour l'affichage.
	La couleur vient de la fleur équipée et l'« animation » de l'effet de
	pétales équipé (Cosmetics.PetalEffects) : traînée, étincelles, orbite de
	mini-pétales, et effet d'impact (éclats, cœurs, pluie de pétales).
]]

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(script.Parent:WaitForChild("Config"))
local Cosmetics = require(script.Parent:WaitForChild("Cosmetics"))

local PetalVisual = {}

local active = {}
local fxFolder = nil
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 170, 40)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 240, 60)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 220, 90)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(70, 140, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(190, 90, 255)),
})
local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"

local function getFolder()
	if not fxFolder or not fxFolder.Parent then
		fxFolder = Instance.new("Folder")
		fxFolder.Name = "FleurPetalsFX"
		fxFolder.Parent = workspace
	end
	return fxFolder
end

function PetalVisual.GetFolder()
	return getFolder()
end

local function fxPart(size, color, cframe)
	local p = Instance.new("Part")
	p.Name = "PetalFX"
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.CFrame = cframe
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere -- ellipsoïde = forme de pétale
	mesh.Parent = p
	p.Parent = getFolder()
	return p
end

---------------------------------------------------------------------------
-- Effets d'impact
---------------------------------------------------------------------------
local function impactBurst(position, color)
	for _ = 1, 5 do
		local bit = fxPart(Vector3.new(0.3, 0.05, 0.4), color,
			CFrame.new(position) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6))
		local offset = Vector3.new(math.random() - 0.5, math.random() * 0.8, math.random() - 0.5) * 4
		TweenService:Create(bit, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = bit.CFrame + offset,
			Transparency = 1,
		}):Play()
		Debris:AddItem(bit, 0.5)
	end
end

local function impactHearts(position, color)
	for _ = 1, 4 do
		local anchor = Instance.new("Part")
		anchor.Transparency = 1
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.Size = Vector3.new(0.1, 0.1, 0.1)
		anchor.CFrame = CFrame.new(position + Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) * 2)
		anchor.Parent = getFolder()
		local billboard = Instance.new("BillboardGui")
		billboard.Size = UDim2.fromScale(1.2, 1.2)
		billboard.LightInfluence = 0
		billboard.Parent = anchor
		local heart = Instance.new("TextLabel")
		heart.Size = UDim2.fromScale(1, 1)
		heart.BackgroundTransparency = 1
		heart.Text = "❤"
		heart.TextScaled = true
		heart.TextColor3 = color
		heart.Parent = billboard
		TweenService:Create(anchor, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			CFrame = anchor.CFrame + Vector3.new(0, 3 + math.random() * 2, 0),
		}):Play()
		TweenService:Create(heart, TweenInfo.new(0.9), { TextTransparency = 1 }):Play()
		Debris:AddItem(anchor, 1)
	end
end

local function impactRain(position, color)
	for _ = 1, 10 do
		local start = position + Vector3.new(math.random() - 0.5, 2 + math.random() * 2, math.random() - 0.5) * 3
		local bit = fxPart(Vector3.new(0.5, 0.08, 0.7), color, CFrame.new(start) * CFrame.Angles(math.random() * 6, math.random() * 6, 0))
		TweenService:Create(bit, TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
			CFrame = CFrame.new(start - Vector3.new(0, 3.5, 0)) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6),
			Transparency = 1,
		}):Play()
		Debris:AddItem(bit, 1.4)
	end
end

local IMPACTS = { Burst = impactBurst, Hearts = impactHearts, Rain = impactRain }

---------------------------------------------------------------------------
-- Pétale tiré
---------------------------------------------------------------------------
-- origin, velocity : Vector3 ; flowerId / effectId : Id de cosmétiques ; ignoreModel : le tireur
function PetalVisual.Spawn(origin, velocity, flowerId, effectId, ignoreModel)
	if velocity.Magnitude < 0.01 then
		return
	end
	local flower = Cosmetics.Get("FlowerSkin", flowerId)
	local effect = Cosmetics.Get("PetalEffect", effectId)
	local color = if flower.PetalColors then flower.PetalColors[math.random(1, #flower.PetalColors)] else flower.PetalColor
	local scale = effect.Size or 1

	local petal = fxPart(Vector3.new(0.8, 0.15, 1.1) * scale, color, CFrame.lookAt(origin, origin + velocity))

	if effect.Trail then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(-0.35 * scale, 0, 0)
		a0.Parent = petal
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0.35 * scale, 0, 0)
		a1.Parent = petal
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Lifetime = 0.3
		trail.LightEmission = 0.5
		trail.FaceCamera = true
		trail.Color = if effect.Trail == "Rainbow" then RAINBOW else ColorSequence.new(color)
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = petal
	end

	if effect.Sparkles then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = SPARKLES
		emitter.Rate = 30
		emitter.Lifetime = NumberRange.new(0.25, 0.45)
		emitter.Speed = NumberRange.new(0.5, 1.5)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new(0.35, 0)
		emitter.LightEmission = 1
		emitter.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.5))
		emitter.Parent = petal
	end

	local orbiters = {}
	for _ = 1, effect.Orbit or 0 do
		table.insert(orbiters, fxPart(Vector3.new(0.4, 0.08, 0.55), flower.HeartColor:Lerp(color, 0.5), petal.CFrame))
	end

	table.insert(active, {
		Part = petal,
		Orbiters = orbiters,
		Pos = origin,
		Vel = velocity,
		Born = os.clock(),
		Spin = math.random() * math.pi * 2,
		Color = color,
		Impact = IMPACTS[effect.Impact] or impactBurst,
		Ignore = ignoreModel,
	})
end

local function destroyEntry(p)
	p.Part:Destroy()
	for _, o in p.Orbiters do
		o:Destroy()
	end
end

if RunService:IsClient() then
	local gravity = Vector3.new(0, -Config.Combat.PetalGravity, 0)
	RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		for i = #active, 1, -1 do
			local p = active[i]
			local finished = false
			if now - p.Born > Config.Combat.PetalLifetime then
				finished = true
			else
				p.Vel += gravity * dt
				local displacement = p.Vel * dt
				params.FilterDescendantsInstances = { getFolder(), p.Ignore }
				local result = workspace:Raycast(p.Pos, displacement, params)
				if result then
					p.Impact(result.Position, p.Color)
					finished = true
				else
					p.Pos += displacement
					p.Spin += dt * 12
					local cf = CFrame.lookAt(p.Pos, p.Pos + p.Vel) * CFrame.Angles(0, 0, p.Spin)
					p.Part.CFrame = cf
					for k, o in p.Orbiters do
						local angle = p.Spin * 0.8 + k * (math.pi * 2 / #p.Orbiters)
						o.CFrame = cf * CFrame.new(math.cos(angle) * 0.9, math.sin(angle) * 0.9, 0)
					end
				end
			end
			if finished then
				destroyEntry(p)
				active[i] = active[#active]
				active[#active] = nil
			end
		end
	end)
end

return PetalVisual
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">WeaponFactory</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Fabrique de l'arme (ModuleScript partagé)
	Emplacement : ReplicatedStorage > FleurShared > WeaponFactory

	Construit par code le fusil « FleurAuFusil » : fusil d'assaut stylisé
	(crosse, carcasse, lunette, chargeur courbe, garde-main ajouré, poignée
	verticale, guidon, cache-flamme) avec une marguerite au bout du canon
	(tige verte, deux feuilles, cœur jaune, pétales blancs vus de profil).
	Les couleurs viennent du skin d'arme et du skin de fleur (Cosmetics).
	Partagé : le serveur l'utilise pour les Tools, le client pour l'aperçu
	dans le casier (ViewportFrame).
]]

local Shared = script.Parent
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))

local WeaponFactory = {}

local SCALE = 0.85 -- taille globale de l'arme
local CYL_Z = CFrame.Angles(0, math.rad(90), 0) -- cylindre orienté vers l'avant (-Z)
local Y = 0.05 -- hauteur de l'axe du canon
local FLOWER = CFrame.new(0, Y, -3.5) -- centre de la fleur

local function at(x, y, z)
	return CFrame.new(x, y, z)
end

local function rx(deg)
	return CFrame.Angles(math.rad(deg), 0, 0)
end

-- Géométrie du fusil (avant = -Z, haut = +Y), en studs avant SCALE.
-- Role : Body | Accent | Metal | Dark | Lens
local GUN = {
	{ "Culasse", "Dark", Vector3.new(0.33, 0.1, 0.36), at(0, 0.08, -0.12) },
	{ "Carcasse", "Body", Vector3.new(0.3, 0.22, 0.9), at(0, -0.26, 0.05) },
	{ "Rail", "Metal", Vector3.new(0.2, 0.07, 1.25), at(0, 0.245, -0.05) },
	{ "Montage", "Metal", Vector3.new(0.16, 0.16, 0.35), at(0, 0.34, 0) },
	{ "Lunette", "Metal", Vector3.new(1.1, 0.26, 0.26), at(0, 0.52, -0.02) * CYL_Z, Enum.PartType.Cylinder },
	{ "LunetteAvant", "Metal", Vector3.new(0.28, 0.36, 0.36), at(0, 0.54, -0.55) * CYL_Z, Enum.PartType.Cylinder },
	{ "LunetteArriere", "Metal", Vector3.new(0.2, 0.3, 0.3), at(0, 0.52, 0.52) * CYL_Z, Enum.PartType.Cylinder },
	{ "Tourelle", "Metal", Vector3.new(0.14, 0.12, 0.14), at(0, 0.69, -0.02) },
	{ "Lentille", "Lens", Vector3.new(0.02, 0.3, 0.3), at(0, 0.54, -0.7) * CYL_Z, Enum.PartType.Cylinder },
	{ "Tube", "Metal", Vector3.new(0.8, 0.18, 0.18), at(0, 0.08, 1.05) * CYL_Z, Enum.PartType.Cylinder },
	{ "Crosse", "Accent", Vector3.new(0.3, 0.4, 0.7), at(0, 0.04, 1.55) },
	{ "CrosseBas", "Accent", Vector3.new(0.26, 0.28, 0.5), at(0, -0.26, 1.6) * rx(12) },
	{ "Plaque", "Metal", Vector3.new(0.32, 0.62, 0.08), at(0, -0.06, 1.93) },
	{ "Poignee", "Accent", Vector3.new(0.24, 0.62, 0.26), at(0, -0.5, 0.38) * rx(-20) },
	{ "Pontet", "Metal", Vector3.new(0.06, 0.06, 0.42), at(0, -0.42, 0.02) },
	{ "Detente", "Metal", Vector3.new(0.05, 0.16, 0.05), at(0, -0.34, 0.08) },
	{ "Chargeur", "Metal", Vector3.new(0.2, 0.8, 0.32), at(0, -0.72, -0.38) * rx(15) },
	{ "TalonChargeur", "Accent", Vector3.new(0.24, 0.1, 0.38), at(0, -0.72, -0.38) * rx(15) * at(0, -0.43, 0) },
	{ "GardeMain", "Accent", Vector3.new(0.34, 0.36, 1.25), at(0, 0.03, -1.3) },
	{ "Fente", "Dark", Vector3.new(0.35, 0.06, 0.16), at(0, 0.1, -0.9) },
	{ "Fente", "Dark", Vector3.new(0.35, 0.06, 0.16), at(0, 0.1, -1.17) },
	{ "Fente", "Dark", Vector3.new(0.35, 0.06, 0.16), at(0, 0.1, -1.44) },
	{ "Fente", "Dark", Vector3.new(0.35, 0.06, 0.16), at(0, 0.1, -1.71) },
	{ "RailAvant", "Metal", Vector3.new(0.2, 0.06, 1.2), at(0, 0.24, -1.3) },
	{ "PoigneeAvant", "Metal", Vector3.new(0.18, 0.5, 0.2), at(0, -0.38, -1.45) },
	{ "BaseGuidon", "Metal", Vector3.new(0.16, 0.14, 0.18), at(0, 0.28, -1.95) },
	{ "Guidon", "Metal", Vector3.new(0.07, 0.38, 0.08), at(0, 0.45, -1.95) },
	{ "Bloc", "Metal", Vector3.new(0.18, 0.2, 0.18), at(0, Y, -1.98) },
	{ "Canon", "Metal", Vector3.new(0.7, 0.12, 0.12), at(0, Y, -2.25) * CYL_Z, Enum.PartType.Cylinder },
	{ "CacheFlamme", "Metal", Vector3.new(0.32, 0.2, 0.2), at(0, Y, -2.65) * CYL_Z, Enum.PartType.Cylinder },
}

local function material(name, fallback)
	if not name then
		return fallback
	end
	local ok, value = pcall(function()
		return Enum.Material[name]
	end)
	return if ok and value then value else fallback
end

local function addPart(handle, name, role, size, cframe, shape, ellipsoid)
	local p = Instance.new("Part")
	p.Name = name
	if shape then
		p.Shape = shape
	end
	p.Size = size * SCALE
	p.CFrame = CFrame.new(cframe.Position * SCALE) * cframe.Rotation
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	p.Anchored = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p:SetAttribute("Role", role)
	if ellipsoid then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = p
	weld.Parent = p
	p.Parent = handle
	return p
end

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 220, 90)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(70, 140, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 90, 255)),
})

-- Couleur d'un pétale (couronne `ring`, position `index`)
function WeaponFactory.PetalColor(flower, ring, index)
	if flower.PetalColors then
		local list = flower.PetalColors
		return list[(index + ring) % #list + 1]
	end
	if ring > 0 then
		return flower.PetalColor2 or flower.PetalColor:Lerp(Color3.new(1, 1, 1), 0.25 * ring)
	end
	return flower.PetalColor
end

local function buildFlower(handle, flower)
	-- tige + deux feuilles entre le cache-flamme et la fleur
	addPart(handle, "Tige", "Stem", Vector3.new(0.65, 0.07, 0.07), at(0, Y, -3.13) * CYL_Z, Enum.PartType.Cylinder)
	addPart(handle, "Feuille", "Stem", Vector3.new(0.05, 0.2, 0.45), at(0, Y + 0.13, -3.0) * rx(35), nil, true)
	addPart(handle, "Feuille", "Stem", Vector3.new(0.05, 0.2, 0.45), at(0, Y - 0.13, -3.0) * rx(-35), nil, true)

	-- fleur vue de profil (comme sur le modèle) : pétales dans le plan YZ
	local heartSize = 0.48 * (flower.HeartScale or 1)
	local heart = addPart(handle, "Coeur", "Heart", Vector3.new(0.22, heartSize, heartSize), FLOWER, nil, true)
	local count = flower.Petals or 12
	local layers = math.clamp(flower.Layers or 1, 1, 3)
	for ring = 0, layers - 1 do
		local scale = 1 - 0.28 * ring
		local length = 0.5 * (flower.PetalLength or 1) * scale
		local width = math.min(0.24 * (flower.PetalWidth or 1), 0.6) * scale
		local radius = heartSize / 2 + length / 2 - 0.05
		local offset = if ring % 2 == 1 then 180 / count else 0 -- couronnes décalées
		for i = 0, count - 1 do
			local petal = addPart(handle, "Petal", "Petal", Vector3.new(0.06 + 0.03 * ring, length, width),
				FLOWER * rx(i * 360 / count + offset) * at(0, radius, 0), nil, true)
			petal:SetAttribute("Ring", ring)
			petal:SetAttribute("Index", i)
		end
	end

	-- aura de particules et lumière pour les fleurs rares
	if flower.Aura or flower.AuraRainbow then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Aura"
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Rate = 10
		emitter.Lifetime = NumberRange.new(0.5, 0.9)
		emitter.Speed = NumberRange.new(0.3, 0.8)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Size = NumberSequence.new(0.25, 0)
		emitter.LightEmission = 1
		emitter.Color = if flower.AuraRainbow then RAINBOW else ColorSequence.new(flower.Aura)
		emitter.Parent = heart
	end
	if flower.Light then
		local light = Instance.new("PointLight")
		light.Range = 5
		light.Brightness = 1.2
		light.Color = flower.Aura or flower.HeartColor
		light.Parent = heart
	end
end

-- Applique les couleurs / matériaux d'une tenue à toutes les pièces
function WeaponFactory.ApplyLook(root, look)
	local skin = Cosmetics.Get("WeaponSkin", look and look.WeaponSkin)
	local flower = Cosmetics.Get("FlowerSkin", look and look.FlowerSkin)
	local base = material(skin.Material, Enum.Material.SmoothPlastic)
	local colors = {
		Body = { skin.Body, base },
		Accent = { skin.Accent, material(skin.AccentMaterial, base) },
		Metal = { skin.Metal, material(skin.MetalMaterial, Enum.Material.SmoothPlastic) },
		Dark = { skin.Dark, Enum.Material.SmoothPlastic },
		Lens = { Color3.fromRGB(90, 190, 255), Enum.Material.Glass },
		Stem = { flower.StemColor, Enum.Material.SmoothPlastic },
		Heart = { flower.HeartColor, material(flower.HeartMaterial, Enum.Material.SmoothPlastic) },
		Petal = { flower.PetalColor, material(flower.PetalMaterial, Enum.Material.SmoothPlastic) },
	}
	local parts = root:GetDescendants()
	if root:IsA("BasePart") then
		table.insert(parts, root)
	end
	for _, p in parts do
		if p:IsA("BasePart") then
			local entry = colors[p:GetAttribute("Role")]
			if entry then
				p.Color = entry[1]
				p.Material = entry[2]
				if p:GetAttribute("Role") == "Petal" then
					p.Color = WeaponFactory.PetalColor(flower, p:GetAttribute("Ring") or 0, p:GetAttribute("Index") or 0)
				end
			end
		end
	end
end

local function buildHandle(look)
	local flower = Cosmetics.Get("FlowerSkin", look and look.FlowerSkin)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.32, 0.42, 1.3) * SCALE -- carcasse supérieure
	handle.CFrame = CFrame.new()
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CastShadow = false
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	handle:SetAttribute("Role", "Body")

	for _, spec in GUN do
		addPart(handle, spec[1], spec[2], spec[3], spec[4], spec[5])
	end
	buildFlower(handle, flower)

	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = Vector3.new(0, Y, -3.6) * SCALE
	muzzle.Parent = handle

	WeaponFactory.ApplyLook(handle, look)
	return handle
end

local function tooltip(tool, tierIndex, look)
	local tier, index = Config.GetTier(tierIndex)
	local skin = Cosmetics.Get("WeaponSkin", look and look.WeaponSkin)
	tool:SetAttribute("Tier", index)
	tool.ToolTip = string.format("La fleur au fusil — %s (%s)", tier.Name, skin.Name)
end

-- Crée le Tool. look = { WeaponSkin, FlowerSkin, PetalEffect } (optionnel)
function WeaponFactory.Create(tierIndex, look)
	local tool = Instance.new("Tool")
	tool.Name = Config.ToolName
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.Grip = CFrame.new(Vector3.new(0, -0.5, 0.38) * SCALE) -- la main tient la poignée pistolet
	tooltip(tool, tierIndex, look)
	buildHandle(look).Parent = tool
	return tool
end

-- Palier de Gun Game : l'apparence (skin) ne change pas, seules les stats changent
function WeaponFactory.SetTier(tool, tierIndex, look)
	tooltip(tool, tierIndex, look)
end

-- Modèle statique pour un aperçu (ViewportFrame) ; l'arme est centrée sur l'origine
function WeaponFactory.CreatePreview(look)
	local model = Instance.new("Model")
	model.Name = "ApercuArme"
	local handle = buildHandle(look)
	for _, d in handle:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	handle.Anchored = true
	handle.Parent = model
	model.PrimaryPart = handle
	return model
end

return WeaponFactory
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX0000000F"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX0000000E"><Properties><string name="Name">FleurServer</string></Properties><Item class="Script" referent="RBX00000007"><Properties><string name="Name">GameManager</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — GameManager (Script serveur principal)
	Emplacement : ServerScriptService > FleurServer > GameManager

	Responsabilités :
	  * crée les RemoteEvents, les équipes, génère le potager ;
	  * gère joueurs, personnages, armes et bots de remplissage ;
	  * enchaîne les parties : Match à mort par équipe → Chacun pour soi →
	    Gun Game (premier à 200 touches), chacune en une ou plusieurs manches ;
	  * calcule les vainqueurs et les scores finaux (touches / pénalités / ratio).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Teams = game:GetService("Teams")

local Config = require(ReplicatedStorage:WaitForChild("FleurShared"):WaitForChild("Config"))
local Modules = script.Parent:WaitForChild("Modules")
local MapBuilder = require(Modules:WaitForChild("MapBuilder"))
local ParticipantService = require(Modules:WaitForChild("ParticipantService"))
local CombatService = require(Modules:WaitForChild("CombatService"))
local WeaponFactory = require(ReplicatedStorage:WaitForChild("FleurShared"):WaitForChild("WeaponFactory"))
local BattlePassService = require(Modules:WaitForChild("BattlePassService"))
local BotService = require(Modules:WaitForChild("BotService"))

local PS = ParticipantService

---------------------------------------------------------------------------
-- Remotes
---------------------------------------------------------------------------
local remotesFolder = Instance.new("Folder")
remotesFolder.Name = Config.RemotesFolderName

local remotes = {}
for _, name in { "FireRequest", "PetalFired", "HitConfirm", "HitTaken", "KillFeed", "GameState", "Scoreboard", "Announce", "MatchResults", "MapVote", "Profile", "Unlocked", "SeedsAwarded", "EquipCosmetic", "BuyPremium", "OpenPack", "PackResult", "BuyProduct" } do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotesFolder
	remotes[name] = r
end
remotes.GetState = Instance.new("RemoteFunction")
remotes.GetState.Name = "GetState"
remotes.GetState.Parent = remotesFolder
remotesFolder.Parent = ReplicatedStorage

---------------------------------------------------------------------------
-- Équipes & carte
---------------------------------------------------------------------------
local teamObjects = {}
for _, t in Config.Teams do
	local team = Teams:FindFirstChild(t.Name) or Instance.new("Team")
	team.Name = t.Name
	team.TeamColor = t.BrickColor
	team.AutoAssignable = false
	team.Parent = Teams
	teamObjects[t.Name] = team
end

MapBuilder.Build(Config.MapSelection.StartMap)
Players.RespawnTime = Config.Combat.RespawnTime

---------------------------------------------------------------------------
-- État de la partie (répliqué aux clients)
---------------------------------------------------------------------------
local currentMode = Config.Modes[Config.ModeRotation[1]]
local state = {
	Phase = "Waiting", -- Waiting | Intermission | Round | RoundEnd | MatchEnd
	ModeKey = "",
	ModeName = "",
	Objective = "",
	Teams = false,
	Round = 0,
	Rounds = 0,
	Target = 0,
	EndsAt = 0, -- workspace:GetServerTimeNow() de fin de phase
	TeamRoundHits = {},
	RoundsWon = {}, -- [clé] = { Label = ..., Wins = n }
	MapId = MapBuilder.GetCurrentMapId(),
	MapName = "",
	MapOptions = nil, -- { {Id, Name, Description}, ... } pendant le vote
	MapVotes = {}, -- [MapId] = nombre de voix
}
local mapInfo = Config.GetMap(state.MapId)
state.MapName = if mapInfo then mapInfo.Name else "Potager personnalisé"
local playerVotes = {} -- [Player] = MapId
local roundWinner = nil -- { Key, Label }

local function broadcastState()
	remotes.GameState:FireAllClients(state)
end

local function setPhase(phase, duration)
	state.Phase = phase
	state.EndsAt = workspace:GetServerTimeNow() + (duration or 0)
	broadcastState()
end

local function announce(text, duration)
	remotes.Announce:FireAllClients(text, duration or 3)
end

remotes.GetState.OnServerInvoke = function()
	return state, PS.Snapshot()
end

-- Tableau des scores, envoyé au plus 2 fois par seconde
local scoreboardDirty = true
PS.OnChanged(function()
	scoreboardDirty = true
end)
task.spawn(function()
	while true do
		task.wait(0.5)
		if scoreboardDirty then
			scoreboardDirty = false
			remotes.Scoreboard:FireAllClients(PS.Snapshot(), state.TeamRoundHits)
		end
	end
end)

---------------------------------------------------------------------------
-- Équipes
---------------------------------------------------------------------------
local function isEnemy(a, b)
	if currentMode.Teams then
		return a.Team ~= b.Team
	end
	return true
end

local function teamCount(teamName)
	local n = 0
	for _, p in PS.All() do
		if p.Team == teamName then
			n += 1
		end
	end
	return n
end

local function smallestTeam()
	local a, b = Config.Teams[1].Name, Config.Teams[2].Name
	return if teamCount(a) <= teamCount(b) then a else b
end

local function addTeamMarker(model, teamName)
	local old = model:FindFirstChild("FleurBrassard")
	if old then
		old:Destroy()
	end
	if not teamName then
		return
	end
	local arm = model:FindFirstChild("LeftUpperArm") or model:FindFirstChild("Left Arm") or model:FindFirstChild("UpperTorso")
	if not arm then
		return
	end
	local band = Instance.new("Part")
	band.Name = "FleurBrassard"
	band.Size = arm.Size * Vector3.new(1.15, 0.35, 1.15)
	band.CFrame = arm.CFrame
	band.Color = teamObjects[teamName].TeamColor.Color
	band.Material = Enum.Material.Neon
	band.CanCollide = false
	band.CanQuery = false
	band.CanTouch = false
	band.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = arm
	weld.Part1 = band
	weld.Parent = band
	band.Parent = model
end

local function applyTeam(p, teamName)
	p.Team = teamName
	if p.Player then
		if teamName then
			p.Player.Team = teamObjects[teamName]
			p.Player.Neutral = false
		else
			p.Player.Team = nil
			p.Player.Neutral = true
		end
		if p.Model then
			addTeamMarker(p.Model, teamName)
		end
	else
		BotService.RefreshAppearance(p)
	end
end

local function assignAllTeams()
	if not currentMode.Teams then
		for _, p in PS.All() do
			applyTeam(p, nil)
		end
		return
	end
	-- humains d'abord (mélangés), puis bots, en alternance : équipes équilibrées
	local humans = PS.Humans()
	for i = #humans, 2, -1 do
		local j = math.random(1, i)
		humans[i], humans[j] = humans[j], humans[i]
	end
	local i = 0
	for _, list in { humans, PS.Bots() } do
		for _, p in list do
			applyTeam(p, Config.Teams[i % 2 + 1].Name)
			i += 1
		end
	end
end

---------------------------------------------------------------------------
-- Paliers d'arme (Gun Game)
---------------------------------------------------------------------------
local function setTier(p, tier)
	if p.Tier == tier then
		return
	end
	p.Tier = tier
	PS.Sync(p)
	if p.IsBot then
		BotService.UpdateTier(p)
	elseif p.Player then
		local tool = (p.Model and p.Model:FindFirstChild(Config.ToolName)) or p.Player.Backpack:FindFirstChild(Config.ToolName)
		if tool then
			WeaponFactory.SetTier(tool, tier, p.Look)
		end
	end
end

---------------------------------------------------------------------------
-- Bots de remplissage
---------------------------------------------------------------------------
local function desiredBotCount()
	if not Config.Bots.Enabled then
		return 0
	end
	return math.clamp(Config.Bots.FillTo - #Players:GetPlayers(), 0, Config.Bots.MaxBots)
end

local function rebalanceBots()
	local desired = desiredBotCount()
	local bots = PS.Bots()
	while #bots > desired do
		-- retirer un bot de l'équipe la plus nombreuse
		local victim = bots[#bots]
		if currentMode.Teams then
			local a, b = Config.Teams[1].Name, Config.Teams[2].Name
			local bigger = if teamCount(a) > teamCount(b) then a else b
			for _, bot in bots do
				if bot.Team == bigger then
					victim = bot
				end
			end
		end
		BotService.RemoveBot(victim)
		bots = PS.Bots()
	end
	while #bots < desired do
		BotService.AddBot()
		bots = PS.Bots()
	end
end

BotService.Init(PS, CombatService, {
	Map = MapBuilder,
	IsEnemy = isEnemy,
	OnCreated = function(p)
		p.Team = if currentMode.Teams then smallestTeam() else nil
	end,
	OnSpawned = function(p)
		if p.Model then
			addTeamMarker(p.Model, if currentMode.Teams then p.Team else nil)
		end
	end,
})

---------------------------------------------------------------------------
-- Joueurs
---------------------------------------------------------------------------
local function onCharacterAdded(player, character)
	local p = PS.GetByPlayer(player)
	if not p then
		return
	end
	character:SetAttribute("FleurId", p.Id)
	character:SetAttribute("FleurTier", p.Tier)
	p.Model = character

	local humanoid = character:WaitForChild("Humanoid")
	humanoid.MaxHealth = Config.Combat.MaxHealth
	humanoid.Health = Config.Combat.MaxHealth
	if Config.Map.CharacterScale ~= 1 then
		pcall(function()
			character:ScaleTo(Config.Map.CharacterScale)
		end)
	end
	p.Alive = true
	humanoid.Died:Connect(function()
		if p.Model == character then
			p.Alive = false
		end
	end)

	-- arme : retire d'éventuels doublons puis équipe automatiquement
	for _, container in { player.Backpack, character } do
		local old = container:FindFirstChild(Config.ToolName)
		if old then
			old:Destroy()
		end
	end
	local tool = WeaponFactory.Create(p.Tier, p.Look)
	tool.Parent = player.Backpack
	task.defer(function()
		if humanoid.Health > 0 and tool.Parent == player.Backpack then
			humanoid:EquipTool(tool)
		end
	end)

	task.defer(addTeamMarker, character, if currentMode.Teams then p.Team else nil)
end

---------------------------------------------------------------------------
-- Cosmétiques (skins d'arme / fleur, animation des pétales)
---------------------------------------------------------------------------
local function applyLook(player, look)
	local p = PS.GetByPlayer(player)
	if not p then
		return -- le participant prendra la tenue chargée à sa création
	end
	p.Look = look
	player:SetAttribute("FleurWeaponSkin", look.WeaponSkin)
	player:SetAttribute("FleurFlower", look.FlowerSkin)
	player:SetAttribute("FleurEffect", look.PetalEffect)

	-- remplace l'arme actuelle par une arme au nouveau skin
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local equipped = character and character:FindFirstChild(Config.ToolName)
	local stored = player.Backpack:FindFirstChild(Config.ToolName)
	if not equipped and not stored then
		return
	end
	if equipped then
		equipped:Destroy()
	end
	if stored then
		stored:Destroy()
	end
	local tool = WeaponFactory.Create(p.Tier, look)
	tool.Parent = player.Backpack
	if equipped and humanoid and humanoid.Health > 0 then
		humanoid:EquipTool(tool)
	end
end

BattlePassService.Init(remotes, applyLook)

local function onPlayerAdded(player)
	local p = PS.AddPlayer(player)
	p.Look = BattlePassService.GetLook(player)
	player:SetAttribute("FleurWeaponSkin", p.Look.WeaponSkin)
	player:SetAttribute("FleurFlower", p.Look.FlowerSkin)
	player:SetAttribute("FleurEffect", p.Look.PetalEffect)
	applyTeam(p, if currentMode.Teams then smallestTeam() else nil)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		onCharacterAdded(player, player.Character)
	end
	rebalanceBots()
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	local p = PS.GetByPlayer(player)
	if p then
		PS.Remove(p.Id)
	end
	task.defer(rebalanceBots)
end)

---------------------------------------------------------------------------
-- Vote de carte
---------------------------------------------------------------------------
local function recountVotes()
	local counts = {}
	for player, mapId in playerVotes do
		if player.Parent then
			counts[mapId] = (counts[mapId] or 0) + 1
		end
	end
	state.MapVotes = counts
end

remotes.MapVote.OnServerEvent:Connect(function(player, mapId)
	if state.Phase ~= "Intermission" or not state.MapOptions or typeof(mapId) ~= "string" then
		return
	end
	for _, option in state.MapOptions do
		if option.Id == mapId then
			playerVotes[player] = mapId
			recountVotes()
			broadcastState()
			return
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	playerVotes[player] = nil
end)

local mapRotationIndex = 0

local function pickMapOptions()
	local pool = {}
	for _, m in Config.Maps do
		if m.Id ~= state.MapId then
			table.insert(pool, m)
		end
	end
	for i = #pool, 2, -1 do
		local j = math.random(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local options = {}
	for i = 1, math.min(Config.MapSelection.Choices, #pool) do
		local m = pool[i]
		table.insert(options, { Id = m.Id, Name = m.Name, Description = m.Description })
	end
	return options
end

local function chooseNextMap()
	local selection = Config.MapSelection.Mode
	if selection == "Rotation" then
		mapRotationIndex = mapRotationIndex % #Config.Maps + 1
		return Config.Maps[mapRotationIndex].Id
	elseif selection == "Random" or not state.MapOptions or #state.MapOptions == 0 then
		local pool = state.MapOptions or Config.Maps
		return pool[math.random(1, #pool)].Id
	end
	-- Vote : le plus de voix gagne, égalité tirée au sort
	local best, bestVotes = {}, -1
	for _, option in state.MapOptions do
		local v = state.MapVotes[option.Id] or 0
		if v > bestVotes then
			best, bestVotes = { option.Id }, v
		elseif v == bestVotes then
			table.insert(best, option.Id)
		end
	end
	return best[math.random(1, #best)]
end

local function loadMap(mapId)
	local loaded = MapBuilder.Build(mapId)
	MapBuilder.ConfigureSpawns(currentMode.Teams)
	local info = Config.GetMap(loaded)
	state.MapId = loaded
	state.MapName = if info then info.Name else "Potager personnalisé"
end

local function isFiniteVector(v)
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6
end

remotes.FireRequest.OnServerEvent:Connect(function(player, origin, direction)
	if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" then
		return
	end
	if not isFiniteVector(origin) or not isFiniteVector(direction) then
		return
	end
	local p = PS.GetByPlayer(player)
	if p then
		CombatService.TryFire(p, origin, direction)
	end
end)

---------------------------------------------------------------------------
-- Touches : objectifs de manche et progression Gun Game
---------------------------------------------------------------------------
CombatService.OnHit(function(shooter, victim, eliminated)
	if state.Phase ~= "Round" then
		return
	end
	if currentMode.Teams and shooter.Team then
		state.TeamRoundHits[shooter.Team] = (state.TeamRoundHits[shooter.Team] or 0) + 1
		if not roundWinner and state.TeamRoundHits[shooter.Team] >= currentMode.TargetPerRound then
			roundWinner = { Key = shooter.Team, Label = "Les " .. shooter.Team }
		end
	elseif not roundWinner and shooter.RoundHits >= currentMode.TargetPerRound then
		roundWinner = { Key = shooter.Id, Label = shooter.Name }
	end

	if currentMode.TierEvery then
		local tier = math.min(#Config.WeaponTiers, math.floor(shooter.RoundHits / currentMode.TierEvery) + 1)
		if tier > shooter.Tier then
			setTier(shooter, tier)
			if shooter.Player then
				remotes.Announce:FireClient(shooter.Player, "Nouvelle fleur : " .. Config.GetTier(tier).Name .. " !", 2)
			end
		end
	end
	scoreboardDirty = true
end)

---------------------------------------------------------------------------
-- Déroulement des parties
---------------------------------------------------------------------------
local function respawnEveryone()
	CombatService.ClearProjectiles()
	for _, player in Players:GetPlayers() do
		task.spawn(function()
			player:LoadCharacter()
		end)
	end
	BotService.RespawnAll()
end

local function decideRoundByScore()
	if currentMode.Teams then
		local a, b = Config.Teams[1].Name, Config.Teams[2].Name
		local ha, hb = state.TeamRoundHits[a] or 0, state.TeamRoundHits[b] or 0
		if ha == hb then
			return nil
		end
		local w = if ha > hb then a else b
		return { Key = w, Label = "Les " .. w }
	end
	local best, bestHits, tie = nil, -1, false
	for _, p in PS.All() do
		if p.RoundHits > bestHits then
			best, bestHits, tie = p, p.RoundHits, false
		elseif p.RoundHits == bestHits then
			tie = true
		end
	end
	if not best or tie or bestHits <= 0 then
		return nil
	end
	return { Key = best.Id, Label = best.Name }
end

local function buildResults()
	local rows = PS.Snapshot()
	local results = { ModeName = currentMode.DisplayName, Rows = rows, TeamTotals = nil, WinnerLabel = "Égalité" }

	-- vainqueur de la partie : plus de manches gagnées, puis meilleur score
	local bestKey, bestWins = nil, 0
	local tie = false
	for key, info in state.RoundsWon do
		if info.Wins > bestWins then
			bestKey, bestWins, tie = key, info.Wins, false
		elseif info.Wins == bestWins then
			tie = true
		end
	end

	if currentMode.Teams then
		local totals = {}
		for _, t in Config.Teams do
			totals[t.Name] = { Hits = 0, Taken = 0, Score = 0 }
		end
		for _, r in rows do
			if r.Team and totals[r.Team] then
				totals[r.Team].Hits += r.Hits
				totals[r.Team].Taken += r.Taken
				totals[r.Team].Score += r.Score
			end
		end
		results.TeamTotals = totals
		if bestKey and not tie then
			results.WinnerLabel = state.RoundsWon[bestKey].Label
			results.WinnerKey = bestKey
		else
			local a, b = Config.Teams[1].Name, Config.Teams[2].Name
			if totals[a].Score ~= totals[b].Score then
				results.WinnerKey = if totals[a].Score > totals[b].Score then a else b
				results.WinnerLabel = "Les " .. results.WinnerKey
			end
		end
	else
		if bestKey and not tie then
			results.WinnerLabel = state.RoundsWon[bestKey].Label
			results.WinnerKey = bestKey
		elseif rows[1] then
			results.WinnerLabel = rows[1].Name
			results.WinnerKey = rows[1].Id
		end
	end
	results.MVP = rows[1] and rows[1].Name or "—"
	results.MVPId = rows[1] and rows[1].Id
	return results
end

-- Graines de fin de partie, selon les statistiques et la victoire
local function awardSeeds(results)
	for _, p in PS.Humans() do
		local player = p.Player
		if player and player.Parent then
			local final, ratio = Config.ComputeScore(p.Hits, p.Taken)
			local won = results.WinnerKey ~= nil
				and ((currentMode.Teams and p.Team == results.WinnerKey) or p.Id == results.WinnerKey)
			local amount, lines = Config.ComputeSeeds({
				Won = won,
				Hits = p.Hits,
				Taken = p.Taken,
				FinalScore = final,
				Ratio = ratio,
				IsMVP = results.MVPId == p.Id,
			}, BattlePassService.HasPremium(player))
			BattlePassService.AwardSeeds(player, amount, lines, { Won = won })
		end
	end
end

local function runMatch(modeKey)
	currentMode = Config.Modes[modeKey]
	state.ModeKey = modeKey
	state.ModeName = currentMode.DisplayName
	state.Teams = currentMode.Teams
	state.Rounds = currentMode.Rounds
	state.Round = 0
	state.Target = currentMode.TargetPerRound
	state.RoundsWon = {}
	state.TeamRoundHits = {}
	if currentMode.TierEvery then
		state.Objective = string.format(currentMode.Description, currentMode.TierEvery, currentMode.TargetPerRound)
	else
		state.Objective = string.format(currentMode.Description, currentMode.TargetPerRound)
	end

	CombatService.Enabled = false
	CombatService.TeamsEnabled = currentMode.Teams
	BotService.SetActive(false)
	MapBuilder.ConfigureSpawns(currentMode.Teams)
	rebalanceBots()
	assignAllTeams()
	PS.ResetMatch()
	for _, p in PS.All() do
		p.Tier = -1 -- force la recoloration
		setTier(p, Config.DefaultTier)
	end

	-- Intermission : vote de la prochaine carte
	table.clear(playerVotes)
	state.MapVotes = {}
	state.MapOptions = if MapBuilder.IsGenerated() and Config.MapSelection.Mode == "Vote" then pickMapOptions() else nil
	announce("Prochaine partie : " .. currentMode.DisplayName, 5)
	setPhase("Intermission", Config.IntermissionTime)
	task.wait(Config.IntermissionTime)

	if MapBuilder.IsGenerated() then
		loadMap(chooseNextMap())
	end
	state.MapOptions = nil
	table.clear(playerVotes)
	broadcastState()

	local winsNeeded = math.floor(currentMode.Rounds / 2) + 1
	for round = 1, currentMode.Rounds do
		if #Players:GetPlayers() == 0 then
			break
		end
		state.Round = round
		state.TeamRoundHits = {}
		for _, t in Config.Teams do
			state.TeamRoundHits[t.Name] = 0
		end
		roundWinner = nil
		PS.ResetRound()
		respawnEveryone()
		task.wait(0.5)

		CombatService.Enabled = true
		BotService.SetActive(true)
		announce((if currentMode.Rounds > 1 then ("Manche " .. round .. " — ") else "") .. state.MapName .. " — À vos fleurs !", 3)
		setPhase("Round", currentMode.RoundTime)

		local deadline = os.clock() + currentMode.RoundTime
		while os.clock() < deadline and not roundWinner and #Players:GetPlayers() > 0 do
			task.wait(0.1)
		end

		CombatService.Enabled = false
		BotService.SetActive(false)
		CombatService.ClearProjectiles()

		local winner = roundWinner or decideRoundByScore()
		if winner then
			local entry = state.RoundsWon[winner.Key] or { Label = winner.Label, Wins = 0 }
			entry.Wins += 1
			state.RoundsWon[winner.Key] = entry
			announce(winner.Label .. " remporte" .. (if currentMode.Teams then "nt" else "") .. " la manche !", 4)
		else
			announce("Manche nulle !", 4)
		end

		local decided = winner and state.RoundsWon[winner.Key].Wins >= winsNeeded
		if round < currentMode.Rounds and not decided then
			setPhase("RoundEnd", Config.RoundBreakTime)
			task.wait(Config.RoundBreakTime)
		end
		if decided then
			break
		end
	end

	local results = buildResults()
	remotes.MatchResults:FireAllClients(results)
	awardSeeds(results)
	announce("Victoire : " .. results.WinnerLabel, 5)
	setPhase("MatchEnd", Config.ResultsTime)
	task.wait(Config.ResultsTime)
end

---------------------------------------------------------------------------
-- Boucle principale
---------------------------------------------------------------------------
task.spawn(function()
	local rotationIndex = 0
	while true do
		if #Players:GetPlayers() == 0 then
			state.Phase = "Waiting"
			BotService.SetActive(false)
			repeat
				task.wait(1)
			until #Players:GetPlayers() > 0
			task.wait(2) -- laisse le temps au personnage d'apparaître
		end
		rotationIndex = rotationIndex % #Config.ModeRotation + 1
		local ok, err = pcall(runMatch, Config.ModeRotation[rotationIndex])
		if not ok then
			warn("[FleurAuFusil] Erreur pendant la partie : " .. tostring(err))
			task.wait(3)
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000000D"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">BattlePassService</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Pass de saison, graines, casier (ModuleScript serveur)
	Emplacement : ServerScriptService > FleurServer > Modules > BattlePassService

	* Profil sauvegardé en DataStore : graines de la saison, objets possédés,
	  tenue équipée.
	* Les graines (gagnées en fin de partie selon les stats) font monter les
	  paliers : récompenses gratuites pour tous, premium si le joueur possède
	  le Game Pass (rétroactif si acheté en cours de saison).
	* Sachets de graines : tirage d'une fleur selon les probabilités de
	  Cosmetics.Packs ; payés avec le solde de graines ou donnés par le pass.
	  Doublon = remboursement en graines.
	* Boutique Robux : sachets vendus en Developer Products (ProcessReceipt,
	  reçus mémorisés pour ne jamais créditer deux fois, sauvegarde immédiate).
	  Bloquée pour les joueurs dont le pays interdit les objets aléatoires
	  payants (PolicyService.ArePaidRandomItemsRestricted).
	* Équipement des cosmétiques (vérifié : seulement les objets possédés).
	Sans accès DataStore (Studio sans « Enable Studio Access to API Services »),
	le profil fonctionne pour la session mais n'est pas sauvegardé.
]]

local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("FleurShared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))

local BattlePassService = {}

local BP = Config.BattlePass
local STORE_NAME = "FleurAuFusil_Profils_v1"

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[FleurPass] DataStore indisponible, progression non sauvegardée : " .. tostring(result))
	end
end

local remotes
local onLookChanged
local profiles = {} -- [Player] = profil
local premium = {} -- [Player] = bool
local canSave = {} -- [Player] = bool (faux si le chargement a échoué : on n'écrase pas les données)
local randomRestricted = {} -- [Player] = bool (objets aléatoires payants interdits)

---------------------------------------------------------------------------
-- Profil
---------------------------------------------------------------------------
local function defaultProfile()
	local owned = {}
	for typeName, id in Cosmetics.Defaults do
		owned[Cosmetics.Key(typeName, id)] = true
	end
	return {
		Version = 1,
		Season = BP.Season,
		Seeds = 0, -- graines de la saison en cours (progression du pass, jamais dépensées)
		TotalSeeds = 0, -- toutes saisons confondues
		SeedBalance = 0, -- solde dépensable (sachets)
		Packs = {}, -- [PackId] = nombre de sachets non ouverts
		Claimed = {}, -- paliers déjà récompensés cette saison ("F3", "P3"…)
		Receipts = {}, -- derniers achats Robux traités (PurchaseId)
		Owned = owned,
		Equipped = Cosmetics.DefaultLook(),
	}
end

local function reconcile(data)
	local profile = defaultProfile()
	if type(data) ~= "table" then
		return profile
	end
	profile.Seeds = tonumber(data.Seeds) or 0
	profile.TotalSeeds = tonumber(data.TotalSeeds) or profile.Seeds
	profile.Season = tonumber(data.Season) or BP.Season
	profile.SeedBalance = tonumber(data.SeedBalance) or 0
	if type(data.Packs) == "table" then
		for id, n in data.Packs do
			if Cosmetics.GetPack(id) and tonumber(n) then
				profile.Packs[id] = math.max(0, math.floor(tonumber(n)))
			end
		end
	end
	if type(data.Receipts) == "table" then
		for _, id in data.Receipts do
			if type(id) == "string" then
				table.insert(profile.Receipts, id)
			end
		end
	end
	if type(data.Claimed) == "table" then
		for key, v in data.Claimed do
			if v then
				profile.Claimed[key] = true
			end
		end
	end
	if type(data.Owned) == "table" then
		for key, v in data.Owned do
			if v then
				profile.Owned[key] = true
			end
		end
	end
	if type(data.Equipped) == "table" then
		for _, typeName in Cosmetics.Types do
			local id = data.Equipped[typeName]
			if type(id) == "string" and Cosmetics.Exists(typeName, id) and profile.Owned[Cosmetics.Key(typeName, id)] then
				profile.Equipped[typeName] = id
			end
		end
	end
	if profile.Season ~= BP.Season then -- nouvelle saison : progression remise à zéro
		profile.Season = BP.Season
		profile.Seeds = 0
		profile.Claimed = {}
	end
	return profile
end

local function keyFor(player)
	return "Joueur_" .. player.UserId
end

-- Renvoie true si la sauvegarde a réussi
local function save(player)
	local profile = profiles[player]
	if not store or not profile or not canSave[player] then
		return false
	end
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player), function()
			return profile
		end)
	end)
	if not ok then
		warn("[FleurPass] Sauvegarde échouée pour " .. player.Name .. " : " .. tostring(err))
	end
	return ok
end

---------------------------------------------------------------------------
-- Pass & récompenses
---------------------------------------------------------------------------
function BattlePassService.HasPremium(player)
	return premium[player] == true
end

-- Palier atteint (0 si aucun) pour un nombre de graines
function BattlePassService.GetTierIndex(seeds)
	local reached = 0
	for i, tier in BP.Tiers do
		if seeds >= tier.Seeds then
			reached = i
		end
	end
	return reached
end

-- Donne toutes les récompenses des paliers atteints. Renvoie les nouveaux objets.
local function grantRewards(player)
	local profile = profiles[player]
	if not profile then
		return {}
	end
	local newItems = {}
	local function give(reward)
		if not reward then
			return
		end
		if reward.Type == "Pack" then
			local pack = Cosmetics.GetPack(reward.Id)
			if pack then
				local count = reward.Count or 1
				profile.Packs[pack.Id] = (profile.Packs[pack.Id] or 0) + count
				table.insert(newItems, { Type = "Pack", Id = pack.Id, Name = string.format("%s ×%d", pack.Name, count), Rarity = "Rare" })
			end
		elseif Cosmetics.Exists(reward.Type, reward.Id) then
			local key = Cosmetics.Key(reward.Type, reward.Id)
			if not profile.Owned[key] then
				profile.Owned[key] = true
				local item = Cosmetics.Get(reward.Type, reward.Id)
				table.insert(newItems, { Type = reward.Type, Id = reward.Id, Name = item.Name, Rarity = item.Rarity })
			end
		end
	end
	for i, tier in BP.Tiers do
		if profile.Seeds >= tier.Seeds then
			if not profile.Claimed["F" .. i] then
				profile.Claimed["F" .. i] = true
				give(tier.Free)
			end
			if premium[player] and not profile.Claimed["P" .. i] then
				profile.Claimed["P" .. i] = true
				give(tier.Premium)
			end
		end
	end
	return newItems
end

local function sendProfile(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	local owned = {}
	for key in profile.Owned do
		table.insert(owned, key)
	end
	remotes.Profile:FireClient(player, {
		Seeds = profile.Seeds,
		TotalSeeds = profile.TotalSeeds,
		Season = profile.Season,
		SeedBalance = profile.SeedBalance,
		Packs = profile.Packs,
		Premium = premium[player] == true,
		Owned = owned,
		Equipped = profile.Equipped,
		Saved = store ~= nil and canSave[player] == true,
		PaidRandomRestricted = randomRestricted[player] == true,
	})
end

local function notifyUnlocks(player, items)
	if #items > 0 then
		remotes.Unlocked:FireClient(player, items)
	end
end

function BattlePassService.GetLook(player)
	local profile = profiles[player]
	return if profile then table.clone(profile.Equipped) else Cosmetics.DefaultLook()
end

-- Ajoute des graines (fin de partie). breakdown = lignes de détail pour l'interface.
function BattlePassService.AwardSeeds(player, amount, breakdown, context)
	local profile = profiles[player]
	if not profile then
		return
	end
	local before = BattlePassService.GetTierIndex(profile.Seeds)
	profile.Seeds += amount
	profile.TotalSeeds += amount
	profile.SeedBalance += amount
	local after = BattlePassService.GetTierIndex(profile.Seeds)
	local items = grantRewards(player)
	remotes.SeedsAwarded:FireClient(player, {
		Amount = amount,
		Lines = breakdown,
		Total = profile.Seeds,
		TierBefore = before,
		TierAfter = after,
		Won = context and context.Won or false,
	})
	notifyUnlocks(player, items)
	sendProfile(player)
end

local function setPremium(player, value, reason)
	if premium[player] == value then
		return
	end
	premium[player] = value
	if value then
		local items = grantRewards(player)
		remotes.Unlocked:FireClient(player, items, reason or "Pass Premium débloqué !")
	end
	sendProfile(player)
end

---------------------------------------------------------------------------
-- Joueurs
---------------------------------------------------------------------------
local function loadPlayer(player)
	local data, ok = nil, true
	if store then
		for attempt = 1, 3 do
			ok = pcall(function()
				data = store:GetAsync(keyFor(player))
			end)
			if ok then
				break
			end
			task.wait(attempt)
		end
	end
	if not player.Parent then
		return
	end
	profiles[player] = reconcile(data)
	canSave[player] = ok
	if not ok then
		warn("[FleurPass] Chargement impossible pour " .. player.Name .. " : la session ne sera pas sauvegardée.")
	end

	if BP.GamePassId and BP.GamePassId > 0 then
		local owns = false
		pcall(function()
			owns = MarketplaceService:UserOwnsGamePassAsync(player.UserId, BP.GamePassId)
		end)
		premium[player] = owns
	end
	local okPolicy, policy = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	-- en cas d'erreur on bloque par prudence (sauf dans Studio)
	randomRestricted[player] = if okPolicy and policy then policy.ArePaidRandomItemsRestricted == true else not RunService:IsStudio()
	grantRewards(player) -- au cas où les paliers ont changé
	sendProfile(player)
	if onLookChanged then
		onLookChanged(player, BattlePassService.GetLook(player))
	end
end

function BattlePassService.Init(remoteTable, lookChangedCallback)
	remotes = remoteTable
	onLookChanged = lookChangedCallback

	Players.PlayerAdded:Connect(loadPlayer)
	for _, player in Players:GetPlayers() do
		task.spawn(loadPlayer, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
		premium[player] = nil
		canSave[player] = nil
	end)

	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			task.spawn(save, player)
		end
		task.wait(if RunService:IsStudio() then 1 else 5)
	end)

	task.spawn(function()
		while true do
			task.wait(120) -- sauvegarde automatique
			for _, player in Players:GetPlayers() do
				task.spawn(save, player)
			end
		end
	end)

	-- Équiper un objet du casier
	remotes.EquipCosmetic.OnServerEvent:Connect(function(player, typeName, id)
		local profile = profiles[player]
		if not profile or type(typeName) ~= "string" or type(id) ~= "string" then
			return
		end
		if not Cosmetics.Exists(typeName, id) or not profile.Owned[Cosmetics.Key(typeName, id)] then
			return
		end
		profile.Equipped[typeName] = id
		sendProfile(player)
		if onLookChanged then
			onLookChanged(player, BattlePassService.GetLook(player))
		end
	end)

	-- Ouvrir un sachet : utilise un sachet en stock, sinon paie avec le solde de graines
	local lastOpen = {}
	local rng = Random.new()
	remotes.OpenPack.OnServerEvent:Connect(function(player, packId)
		local profile = profiles[player]
		local pack = type(packId) == "string" and Cosmetics.GetPack(packId)
		if not profile or not pack then
			return
		end
		local now = os.clock()
		if lastOpen[player] and now - lastOpen[player] < 1 then
			return -- anti-spam
		end
		local fromStock = (profile.Packs[pack.Id] or 0) > 0
		if fromStock then
			profile.Packs[pack.Id] -= 1
		elseif profile.SeedBalance >= pack.Price then
			profile.SeedBalance -= pack.Price
		else
			remotes.PackResult:FireClient(player, { Error = "Pas assez de graines !" })
			return
		end
		lastOpen[player] = now

		local flower = Cosmetics.RollPack(pack, rng)
		local key = Cosmetics.Key("FlowerSkin", flower.Id)
		local duplicate = profile.Owned[key] == true
		local refund = 0
		if duplicate then
			refund = (Cosmetics.Rarities[flower.Rarity] or Cosmetics.Rarities.Commune).Refund
			profile.SeedBalance += refund
		else
			profile.Owned[key] = true
		end
		remotes.PackResult:FireClient(player, {
			PackId = pack.Id,
			FlowerId = flower.Id,
			Duplicate = duplicate,
			Refund = refund,
		})
		sendProfile(player)
		local rarity = Cosmetics.Rarities[flower.Rarity]
		if rarity and rarity.Order >= 6 then -- Mythique et plus : annonce à tout le serveur
			remotes.Unlocked:FireAllClients({}, string.format("🌸 %s a obtenu %s (%s) !", player.DisplayName, flower.Name, rarity.Label))
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastOpen[player] = nil
		randomRestricted[player] = nil
	end)

	-----------------------------------------------------------------------
	-- Boutique Robux : sachets (Developer Products)
	-----------------------------------------------------------------------
	local function grantProduct(player, product)
		local profile = profiles[player]
		profile.Packs[product.PackId] = (profile.Packs[product.PackId] or 0) + product.Count
		local pack = Cosmetics.GetPack(product.PackId)
		remotes.Unlocked:FireClient(player, {}, string.format("Merci ! %s ×%d ajouté(s) 🌸", pack.Name, product.Count))
		sendProfile(player)
	end

	remotes.BuyProduct.OnServerEvent:Connect(function(player, key)
		local product = type(key) == "string" and Config.GetProduct(key)
		if not product or not profiles[player] then
			return
		end
		if randomRestricted[player] then
			remotes.Unlocked:FireClient(player, {}, "Les sachets payants ne sont pas disponibles dans votre pays.")
			return
		end
		if product.ProductId ~= 0 then
			MarketplaceService:PromptProductPurchase(player, product.ProductId)
		elseif RunService:IsStudio() and Config.Shop.StudioFreeProducts then
			grantProduct(player, product) -- achat simulé (test Studio)
		else
			remotes.Unlocked:FireClient(player, {}, "Produit indisponible : ProductId non configuré.")
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local product = Config.GetProductById(receipt.ProductId)
		if not product then
			return Enum.ProductPurchaseDecision.NotProcessedYet -- produit inconnu de ce serveur
		end
		local profile = player and profiles[player]
		if not profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet -- Roblox réessaiera au prochain passage
		end
		if table.find(profile.Receipts, receipt.PurchaseId) then
			return Enum.ProductPurchaseDecision.PurchaseGranted -- déjà crédité
		end
		if store and not canSave[player] then
			return Enum.ProductPurchaseDecision.NotProcessedYet -- profil non fiable : on ne crédite pas
		end

		table.insert(profile.Receipts, receipt.PurchaseId)
		while #profile.Receipts > 50 do
			table.remove(profile.Receipts, 1)
		end
		profile.Packs[product.PackId] = (profile.Packs[product.PackId] or 0) + product.Count

		if store and not save(player) then
			-- échec de sauvegarde : on annule, Roblox renverra le reçu plus tard
			profile.Packs[product.PackId] -= product.Count
			table.remove(profile.Receipts, table.find(profile.Receipts, receipt.PurchaseId))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local pack = Cosmetics.GetPack(product.PackId)
		remotes.Unlocked:FireClient(player, {}, string.format("Merci ! %s ×%d ajouté(s) 🌸", pack.Name, product.Count))
		sendProfile(player)
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	-- Achat du pass premium
	remotes.BuyPremium.OnServerEvent:Connect(function(player)
		if premium[player] then
			return
		end
		if BP.GamePassId and BP.GamePassId > 0 then
			MarketplaceService:PromptGamePassPurchase(player, BP.GamePassId)
		elseif RunService:IsStudio() and BP.StudioFreePremium then
			setPremium(player, true, "Pass Premium débloqué (mode test Studio)")
		else
			remotes.Unlocked:FireClient(player, {}, "Pass Premium indisponible : GamePassId non configuré.")
		end
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, purchased)
		if purchased and gamePassId == BP.GamePassId then
			setPremium(player, true, "Merci ! Pass Premium débloqué 🌸")
		end
	end)
end

return BattlePassService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">BotService</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — IA des bots (ModuleScript serveur)
	Emplacement : ServerScriptService > FleurServer > Modules > BotService

	Bots basiques mais crédibles :
	  * Recherche de cible : ennemi vivant le plus proche avec ligne de vue.
	  * Combat : se tourne vers la cible, mitraille en respectant la cadence de
	    la fleur, anticipe le déplacement et la chute du pétale, avec une
	    imprécision réglable ; garde une distance idéale et fait du strafe.
	  * Navigation : PathfindingService vers l'ennemi le plus proche (ou un
	    point au hasard), avec détection de blocage (saut + recalcul).
	  * Réapparition automatique après élimination.
	Les bots tirent via CombatService.TryFire, exactement comme les joueurs.
]]

local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("FleurShared"):WaitForChild("Config"))
local WeaponFactory = require(ReplicatedStorage:WaitForChild("FleurShared"):WaitForChild("WeaponFactory"))
local Cosmetics = require(ReplicatedStorage:WaitForChild("FleurShared"):WaitForChild("Cosmetics"))

local BotService = {}
BotService.Active = false -- les bots ne bougent / tirent que pendant une manche

local PS, Combat, Map
local hooks = {}
local brains = {} -- [participant] = état de l'IA
local folder
local rng = Random.new()
local nameCursor = 0
local losParams = RaycastParams.new()
losParams.FilterType = Enum.RaycastFilterType.Exclude

local BC = Config.Bots

---------------------------------------------------------------------------
-- Construction du personnage
---------------------------------------------------------------------------
local function teamColor(p)
	if p.Team then
		for _, t in Config.Teams do
			if t.Name == p.Team then
				return t.BrickColor.Color
			end
		end
	end
	return Color3.fromHSV(rng:NextNumber(), 0.55, 0.85)
end

local function buildFallbackRig(color)
	-- Rig minimal si CreateHumanoidModelFromDescription échoue
	local model = Instance.new("Model")
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.Parent = model
	local function limb(name, size, offset, c)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = c
		part.CFrame = root.CFrame * CFrame.new(offset)
		part.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		return part
	end
	limb("UpperTorso", Vector3.new(2, 2, 1), Vector3.zero, color)
	limb("Head", Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 1.6, 0), Color3.fromRGB(255, 220, 180))
	limb("LeftLeg", Vector3.new(0.9, 2, 1), Vector3.new(-0.5, -2, 0), Color3.fromRGB(60, 60, 60))
	limb("RightLeg", Vector3.new(0.9, 2, 1), Vector3.new(0.5, -2, 0), Color3.fromRGB(60, 60, 60))
	local rightHand = limb("RightHand", Vector3.new(0.6, 0.6, 0.6), Vector3.new(1.4, 0, -0.5), Color3.fromRGB(255, 220, 180))
	local grip = Instance.new("Attachment")
	grip.Name = "RightGripAttachment"
	grip.Parent = rightHand
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 2
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

local function buildModel(p)
	local color = teamColor(p)
	local desc = Instance.new("HumanoidDescription")
	local skin = Color3.fromRGB(255, 220, 180):Lerp(Color3.fromRGB(120, 80, 50), rng:NextNumber())
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = color
	desc.LeftLegColor = Color3.fromRGB(60, 60, 70)
	desc.RightLegColor = Color3.fromRGB(60, 60, 70)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		model = buildFallbackRig(color)
	end
	return model
end

local function setupAnimations(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local function load(id, priority)
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local ok, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		if ok and track then
			track.Priority = priority
			track.Looped = true
			return track
		end
		return nil
	end
	local idle = load(BC.Animations.Idle, Enum.AnimationPriority.Idle)
	local walk = load(BC.Animations.Walk, Enum.AnimationPriority.Movement)
	local hold = load(BC.Animations.Hold, Enum.AnimationPriority.Action)
	if idle then idle:Play() end
	if hold then hold:Play() end
	humanoid.Running:Connect(function(speed)
		if not walk then
			return
		end
		if speed > 0.5 and not walk.IsPlaying then
			walk:Play(0.15)
		elseif speed <= 0.5 and walk.IsPlaying then
			walk:Stop(0.2)
		end
	end)
end

local function newBrain()
	return {
		Target = nil,
		TargetSince = 0,
		Path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 8 }),
		Waypoints = nil,
		WpIndex = 1,
		Goal = nil,
		LastPath = 0,
		Computing = false,
		StrafeDir = 1,
		NextStrafe = 0,
		LastPos = nil,
		LastMoveCheck = 0,
		NextThink = 0,
	}
end

local function spawnBot(p)
	if not PS.Get(p.Id) then
		return
	end
	if p.Model then
		p.Model:Destroy()
		p.Model = nil
	end

	local model = buildModel(p)
	model.Name = p.Name
	model:SetAttribute("FleurId", p.Id)
	model:SetAttribute("FleurTier", p.Tier)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = "🌱 " .. p.Name
	humanoid.MaxHealth = Config.Combat.MaxHealth
	humanoid.Health = Config.Combat.MaxHealth
	humanoid.WalkSpeed = BC.WalkSpeed
	model:PivotTo(Map.GetSpawnCFrame(p.Team))
	model.Parent = folder

	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part:CanSetNetworkOwnership() then
			part:SetNetworkOwner(nil) -- physique gérée par le serveur
		end
	end

	local forceField = Instance.new("ForceField")
	forceField.Visible = true
	forceField.Parent = model
	Debris:AddItem(forceField, Config.Combat.SpawnProtection)

	local tool = WeaponFactory.Create(p.Tier, p.Look)
	tool.Parent = model
	pcall(function()
		humanoid:EquipTool(tool)
	end)
	pcall(setupAnimations, humanoid)

	p.Model = model
	p.Alive = true
	p.LastFire = 0
	brains[p] = newBrain()

	humanoid.Died:Connect(function()
		p.Alive = false
		task.delay(Config.Combat.RespawnTime, function()
			if PS.Get(p.Id) == p and p.Model == model then
				spawnBot(p)
			end
		end)
	end)

	if hooks.OnSpawned then
		hooks.OnSpawned(p)
	end
end

---------------------------------------------------------------------------
-- Gestion de la population
---------------------------------------------------------------------------
function BotService.AddBot()
	nameCursor += 1
	local base = BC.Names[(nameCursor - 1) % #BC.Names + 1]
	local suffix = if nameCursor > #BC.Names then " " .. tostring(math.ceil(nameCursor / #BC.Names)) else ""
	local p = PS.AddBot(base .. suffix)
	p.Look = Cosmetics.RandomLook(rng) -- les bots exhibent des skins variés
	if hooks.OnCreated then
		hooks.OnCreated(p)
	end
	spawnBot(p)
	return p
end

function BotService.RemoveBot(p)
	brains[p] = nil
	if p.Model then
		p.Model:Destroy()
		p.Model = nil
	end
	p.Alive = false
	PS.Remove(p.Id)
end

function BotService.RespawnAll()
	for _, p in PS.Bots() do
		spawnBot(p)
	end
end

function BotService.UpdateTier(p)
	if p.Model then
		local tool = p.Model:FindFirstChild(Config.ToolName)
		if tool then
			WeaponFactory.SetTier(tool, p.Tier, p.Look)
		end
	end
end

function BotService.RefreshAppearance(p)
	if not p.Model then
		return
	end
	local color = teamColor(p)
	for _, name in { "UpperTorso", "LowerTorso", "Torso" } do
		local part = p.Model:FindFirstChild(name)
		if part and part:IsA("BasePart") then
			part.Color = color
		end
	end
	if hooks.OnSpawned then
		hooks.OnSpawned(p)
	end
end

---------------------------------------------------------------------------
-- Perception
---------------------------------------------------------------------------
local function aimPartOf(model)
	return model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
end

local function hasLineOfSight(fromPos, selfModel, targetModel)
	local part = targetModel:FindFirstChild("Head") or aimPartOf(targetModel)
	if not part then
		return false
	end
	losParams.FilterDescendantsInstances = { selfModel }
	local result = workspace:Raycast(fromPos, part.Position - fromPos, losParams)
	return result == nil or result.Instance:IsDescendantOf(targetModel)
end

local function isValidEnemy(p, other)
	if other == p or not other.Alive or not other.Model then
		return false
	end
	local hum = other.Model:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return false
	end
	return hooks.IsEnemy(p, other)
end

local function findTargets(p, root, eye)
	local visible, visibleDist = nil, math.huge
	local nearest, nearestDist = nil, math.huge
	for _, other in PS.All() do
		if isValidEnemy(p, other) then
			local oroot = other.Model:FindFirstChild("HumanoidRootPart")
			if oroot then
				local d = (oroot.Position - root.Position).Magnitude
				if d < nearestDist then
					nearest, nearestDist = other, d
				end
				if d < BC.SightRange and d < visibleDist and hasLineOfSight(eye, p.Model, other.Model) then
					visible, visibleDist = other, d
				end
			end
		end
	end
	return visible, nearest
end

---------------------------------------------------------------------------
-- Déplacement
---------------------------------------------------------------------------
local function moveAlongPath(brain, humanoid, root, goal, now)
	local needRepath = brain.Waypoints == nil
		or now - brain.LastPath > BC.RepathInterval
		or (brain.Goal and (brain.Goal - goal).Magnitude > 30)
	if needRepath and not brain.Computing then
		brain.Computing = true
		local from = root.Position
		task.spawn(function()
			local ok = pcall(function()
				brain.Path:ComputeAsync(from, goal)
			end)
			if ok and brain.Path.Status == Enum.PathStatus.Success then
				brain.Waypoints = brain.Path:GetWaypoints()
				brain.WpIndex = 2
			else
				brain.Waypoints = nil
			end
			brain.Goal = goal
			brain.LastPath = os.clock()
			brain.Computing = false
		end)
	end

	local waypoints = brain.Waypoints
	local wp = waypoints and waypoints[brain.WpIndex]
	if wp then
		local flat = (wp.Position - root.Position) * Vector3.new(1, 0, 1)
		if flat.Magnitude < 4 then
			brain.WpIndex += 1
			wp = waypoints[brain.WpIndex]
		end
	end
	if wp then
		humanoid:MoveTo(wp.Position)
		if wp.Action == Enum.PathWaypointAction.Jump then
			humanoid.Jump = true
		end
	else
		humanoid:MoveTo(goal) -- ligne droite en secours
	end
end

local function checkStuck(brain, humanoid, root, now)
	if now - brain.LastMoveCheck < 1.5 then
		return
	end
	if brain.LastPos and (root.Position - brain.LastPos).Magnitude < 1.5 then
		humanoid.Jump = true
		brain.Waypoints = nil
		brain.StrafeDir = -brain.StrafeDir
	end
	brain.LastPos = root.Position
	brain.LastMoveCheck = now
end

---------------------------------------------------------------------------
-- Combat
---------------------------------------------------------------------------
local function engage(p, brain, humanoid, root, target, now)
	local troot = target.Model:FindFirstChild("HumanoidRootPart")
	local aimPart = aimPartOf(target.Model)
	if not troot or not aimPart then
		return
	end

	-- se tourner vers la cible
	local toTarget = troot.Position - root.Position
	local flat = Vector3.new(toTarget.X, 0, toTarget.Z)
	local dist = flat.Magnitude
	if dist < 0.1 then
		return
	end
	local forward = flat.Unit
	humanoid.AutoRotate = false
	root.CFrame = CFrame.lookAt(root.Position, root.Position + forward)

	-- strafe + gestion de la distance
	if now > brain.NextStrafe then
		brain.StrafeDir = if rng:NextNumber() < 0.5 then -1 else 1
		brain.NextStrafe = now + rng:NextNumber(0.8, 2.0)
		if rng:NextNumber() < 0.15 then
			humanoid.Jump = true
		end
	end
	local move = forward:Cross(Vector3.yAxis) * brain.StrafeDir
	if dist > BC.PreferredRange * 1.3 then
		move += forward * 1.5
	elseif dist < BC.PreferredRange * 0.6 then
		move -= forward
	end
	humanoid:MoveTo(root.Position + move.Unit * 10)

	-- tir
	if now - brain.TargetSince < BC.ReactionTime then
		return
	end
	local tier = Config.GetTier(p.Tier)
	if now - p.LastFire < tier.Cooldown then
		return
	end
	local origin = Combat.GetMuzzle(p)
	if not origin then
		return
	end
	local targetPos = aimPart.Position
	local travel = (targetPos - origin).Magnitude / tier.Speed
	local lead = troot.AssemblyLinearVelocity * Vector3.new(1, 0, 1) * travel * BC.LeadSkill
	local drop = Vector3.new(0, 0.5 * Config.Combat.PetalGravity * travel * travel, 0)
	local aim = targetPos + lead + drop
	local direction = Config.ApplySpread(aim - origin, BC.AimErrorDegrees, rng)
	Combat.TryFire(p, origin, direction)
end

local function think(p, brain, now)
	local model = p.Model
	if not p.Alive or not model then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	local head = model:FindFirstChild("Head") or root
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end

	local visible, nearest = findTargets(p, root, head.Position)
	if visible then
		if brain.Target ~= visible then
			brain.Target = visible
			brain.TargetSince = now
		end
		engage(p, brain, humanoid, root, visible, now)
	else
		brain.Target = nil
		humanoid.AutoRotate = true
		local goal
		if nearest then
			goal = nearest.Model.HumanoidRootPart.Position
		else
			if not brain.Goal or (brain.Goal - root.Position).Magnitude < 10 then
				brain.Goal = Map.GetRandomPoint()
			end
			goal = brain.Goal
		end
		moveAlongPath(brain, humanoid, root, goal, now)
	end
	checkStuck(brain, humanoid, root, now)
end

---------------------------------------------------------------------------
-- Boucle principale
---------------------------------------------------------------------------
function BotService.SetActive(active)
	BotService.Active = active
	if not active then
		for p in brains do
			local humanoid = p.Model and p.Model:FindFirstChildOfClass("Humanoid")
			local root = p.Model and p.Model:FindFirstChild("HumanoidRootPart")
			if humanoid and root then
				humanoid:MoveTo(root.Position)
				humanoid.AutoRotate = true
			end
		end
	end
end

-- options = { Map, IsEnemy(a, b), OnCreated(p), OnSpawned(p) }
function BotService.Init(participantService, combatService, options)
	PS = participantService
	Combat = combatService
	Map = options.Map
	hooks.IsEnemy = options.IsEnemy
	hooks.OnCreated = options.OnCreated
	hooks.OnSpawned = options.OnSpawned

	folder = workspace:FindFirstChild(Config.BotsFolderName) or Instance.new("Folder")
	folder.Name = Config.BotsFolderName
	folder.Parent = workspace

	RunService.Heartbeat:Connect(function()
		if not BotService.Active then
			return
		end
		local now = os.clock()
		for p, brain in brains do
			if now >= brain.NextThink then
				brain.NextThink = now + BC.ThinkInterval * rng:NextNumber(0.8, 1.2)
				local ok, err = pcall(think, p, brain, now)
				if not ok then
					warn("[FleurBots] " .. tostring(err))
				end
			end
		end
	end)
end

return BotService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Projectiles & touches (ModuleScript serveur)
	Emplacement : ServerScriptService > FleurServer > Modules > CombatService

	Autorité serveur :
	  * vérifie la cadence de tir (cooldown anti-spam) de chaque combattant ;
	  * simule chaque pétale (vitesse + gravité) par Spherecast à chaque frame ;
	  * applique les dégâts, compte touches données / reçues ;
	  * diffuse les tirs aux clients pour l'affichage.
	Joueurs et bots passent par la même fonction TryFire.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("FleurShared"):WaitForChild("Config"))

local CombatService = {}
CombatService.Enabled = false -- vrai uniquement pendant une manche
CombatService.TeamsEnabled = false -- tir ami désactivé en mode équipe

local PS
local remotes
local projectiles = {}
local hitListeners = {}
local rng = Random.new()
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

function CombatService.OnHit(fn)
	table.insert(hitListeners, fn)
end

local function getHumanoid(p)
	return p.Model and p.Model:FindFirstChildOfClass("Humanoid")
end

local function getRoot(p)
	return p.Model and p.Model:FindFirstChild("HumanoidRootPart")
end

function CombatService.GetMuzzle(p)
	if not p.Model then
		return nil
	end
	local tool = p.Model:FindFirstChild(Config.ToolName)
	local handle = tool and tool:FindFirstChild("Handle")
	local muzzle = handle and handle:FindFirstChild("Muzzle")
	if muzzle then
		return muzzle.WorldPosition
	end
	local head = p.Model:FindFirstChild("Head")
	return head and head.Position
end

function CombatService.IsFriendly(a, b)
	return CombatService.TeamsEnabled and a.Team ~= nil and a.Team == b.Team
end

function CombatService.ClearProjectiles()
	table.clear(projectiles)
end

-- Tente un tir. Renvoie true si le tir est accepté.
function CombatService.TryFire(p, origin, direction)
	if not CombatService.Enabled or not p.Alive or not p.Model then
		return false
	end
	local humanoid = getHumanoid(p)
	local root = getRoot(p)
	if not humanoid or humanoid.Health <= 0 or not root then
		return false
	end
	if not p.Model:FindFirstChild(Config.ToolName) then
		return false -- l'arme doit être en main
	end

	local tier = Config.GetTier(p.Tier)
	local now = os.clock()
	local tolerance = if p.IsBot then 1 else Config.Combat.CooldownTolerance
	if now - p.LastFire < tier.Cooldown * tolerance then
		return false -- anti-spam
	end
	if direction.Magnitude < 0.01 then
		return false
	end
	if (origin - root.Position).Magnitude > Config.Combat.MaxOriginOffset then
		origin = CombatService.GetMuzzle(p) or root.Position -- origine suspecte : on la corrige
	end
	p.LastFire = now

	local velocities = {}
	for _ = 1, tier.Petals do
		local velocity = Config.ApplySpread(direction, tier.Spread, rng) * tier.Speed
		table.insert(velocities, velocity)
		table.insert(projectiles, {
			Pos = origin,
			Vel = velocity,
			Shooter = p,
			Born = now,
			Damage = tier.Damage,
		})
	end
	remotes.PetalFired:FireAllClients(p.Id, origin, velocities, p.Tier, p.Look.FlowerSkin, p.Look.PetalEffect)
	return true
end

local function onImpact(projectile)
	local shooter = projectile.Shooter
	local victim = projectile.Victim
	if not CombatService.Enabled or not victim or victim == shooter or not victim.Alive then
		return
	end
	if CombatService.IsFriendly(shooter, victim) then
		return
	end
	local humanoid = getHumanoid(victim)
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	if victim.Model:FindFirstChildOfClass("ForceField") then
		return -- protection d'apparition
	end

	humanoid:TakeDamage(projectile.Damage)
	local eliminated = humanoid.Health <= 0
	PS.RegisterHit(shooter, victim)

	if shooter.Player then
		remotes.HitConfirm:FireClient(shooter.Player, victim.Name, eliminated)
	end
	if victim.Player then
		remotes.HitTaken:FireClient(victim.Player, shooter.Name, projectile.Pos)
	end
	if eliminated then
		remotes.KillFeed:FireAllClients(shooter.Name, victim.Name, Config.GetTier(shooter.Tier).Name)
	end
	for _, fn in hitListeners do
		task.spawn(fn, shooter, victim, eliminated)
	end
end

local function step(dt)
	if #projectiles == 0 then
		return
	end
	local now = os.clock()
	local gravity = Vector3.new(0, -Config.Combat.PetalGravity, 0)
	for i = #projectiles, 1, -1 do
		local pr = projectiles[i]
		local finished = false
		if now - pr.Born > Config.Combat.PetalLifetime then
			finished = true
		else
			pr.Vel += gravity * dt
			local displacement = pr.Vel * dt
			params.FilterDescendantsInstances = { pr.Shooter.Model }
			local result = workspace:Spherecast(pr.Pos, Config.Combat.PetalRadius, displacement, params)
			if result then
				pr.Pos = result.Position
				pr.Victim = PS.FromInstance(result.Instance)
				onImpact(pr)
				finished = true
			else
				pr.Pos += displacement
			end
		end
		if finished then
			projectiles[i] = projectiles[#projectiles]
			projectiles[#projectiles] = nil
		end
	end
end

function CombatService.Init(participantService, remoteTable)
	PS = participantService
	remotes = remoteTable
	RunService.Heartbeat:Connect(step)
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Générateur de potagers géants (ModuleScript serveur)
	Emplacement : ServerScriptService > FleurServer > Modules > MapBuilder

	11 cartes générées par code (voir Config.Maps) :
	  Tomates, Ail, Carottes, Citrouilles, Salades, Fraises, Maïs (labyrinthe),
	  Choux, Piments, Tournesols et « Multi » (le grand potager mélangé).
	Chaque thème définit : légumes des rangs, densité, couleurs du sol,
	monument central, décors, paquets de graines et ambiance lumineuse.
	La disposition de base (clôture, rangs, spawns des deux camps et neutres)
	est commune à toutes les cartes pour garder un jeu équilibré.

	Échelle : un personnage (≈5 studs) est minuscule à côté d'une carotte de
	15 studs de diamètre, d'une citrouille de 35 studs ou d'un maïs de 90 studs.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("FleurShared"):WaitForChild("Config"))

local MapBuilder = {}

local rng = Random.new(Config.Map.Seed)
local mapFolder
local spawns = { Neutral = {} }
local teamsMode = false
local currentMapId = nil

local C = {
	Dirt = Color3.fromRGB(105, 72, 45),
	DarkDirt = Color3.fromRGB(80, 54, 34),
	Grass = Color3.fromRGB(90, 160, 70),
	Leaf = Color3.fromRGB(70, 150, 55),
	DarkLeaf = Color3.fromRGB(45, 110, 40),
	Orange = Color3.fromRGB(240, 120, 30),
	Tomato = Color3.fromRGB(215, 35, 30),
	Radish = Color3.fromRGB(205, 40, 90),
	Wood = Color3.fromRGB(150, 105, 65),
	Pot = Color3.fromRGB(196, 98, 52),
	Stone = Color3.fromRGB(130, 128, 122),
	Metal = Color3.fromRGB(70, 140, 110),
	Garlic = Color3.fromRGB(245, 240, 225),
	GarlicLeaf = Color3.fromRGB(95, 145, 110),
	Straw = Color3.fromRGB(225, 195, 110),
	Strawberry = Color3.fromRGB(225, 25, 45),
	Corn = Color3.fromRGB(250, 210, 60),
	CornLeaf = Color3.fromRGB(110, 160, 60),
	Cabbage = Color3.fromRGB(160, 205, 120),
	RedCabbage = Color3.fromRGB(120, 50, 120),
	Sunflower = Color3.fromRGB(255, 200, 20),
	SunflowerHeart = Color3.fromRGB(85, 50, 20),
}

---------------------------------------------------------------------------
-- Aides de construction
---------------------------------------------------------------------------
local function newPart(props)
	local p = Instance.new(props.Class or "Part")
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		if k ~= "Class" and k ~= "Shape" and k ~= "Parent" and k ~= "Ellipsoid" then
			p[k] = v
		end
	end
	if props.Ellipsoid then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = props.Parent or mapFolder
	return p
end

local VERTICAL = CFrame.Angles(0, 0, math.rad(90)) -- l'axe des cylindres Roblox est X

local function vcyl(name, height, diameter, bottom, color, material, parent)
	return newPart({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = CFrame.new(bottom + Vector3.new(0, height / 2, 0)) * VERTICAL,
		Color = color,
		Material = material,
		Parent = parent,
	})
end

local function ball(name, d, center, color, parent, material)
	return newPart({ Name = name, Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d),
		CFrame = CFrame.new(center), Color = color, Material = material, Parent = parent })
end

-- Feuille / lame qui part de `origin`, orientée selon yaw et inclinée de `tilt` degrés
local function blade(name, origin, yaw, tilt, size, color, parent, ellipsoid)
	local cf = CFrame.new(origin) * CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(math.rad(tilt), 0, 0) * CFrame.new(0, size.Y / 2, 0)
	return newPart({ Name = name, Size = size, CFrame = cf, Color = color, Material = Enum.Material.LeafyGrass,
		CanCollide = false, Parent = parent, Ellipsoid = ellipsoid })
end

local function group(name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = mapFolder
	return m
end

---------------------------------------------------------------------------
-- Légumes
---------------------------------------------------------------------------
local Crops = {}

function Crops.carrot(base)
	local m = group("Carotte")
	local d = rng:NextNumber(11, 17)
	local h = rng:NextNumber(5, 9)
	vcyl("Racine", h, d, base, C.Orange, nil, m)
	local top = base + Vector3.new(0, h, 0)
	for i = 1, 6 do
		blade("Fane", top, i * 60 + rng:NextNumber(-15, 15), rng:NextNumber(12, 30), Vector3.new(1.2, rng:NextNumber(30, 50), 4), C.Leaf, m)
	end
end

function Crops.lettuce(base)
	local m = group("Laitue")
	for _ = 1, 7 do
		local d = rng:NextNumber(12, 22)
		local offset = Vector3.new(rng:NextNumber(-8, 8), d * 0.25, rng:NextNumber(-8, 8))
		ball("Feuille", d, base + offset, C.Leaf:Lerp(Color3.fromRGB(170, 220, 90), rng:NextNumber()), m, Enum.Material.LeafyGrass)
	end
end

function Crops.tomato(base)
	local m = group("Tomate")
	local h = rng:NextNumber(45, 65)
	newPart({ Name = "Tuteur", Size = Vector3.new(2.5, h + 10, 2.5), CFrame = CFrame.new(base + Vector3.new(4, (h + 10) / 2, 0)),
		Color = C.Wood, Material = Enum.Material.Wood, Parent = m })
	vcyl("Tige", h, 3, base, C.DarkLeaf, nil, m)
	for i = 1, 4 do
		local y = h * (0.25 + 0.17 * i)
		local branch = CFrame.new(base + Vector3.new(0, y, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		newPart({ Name = "Branche", Size = Vector3.new(1.4, 1.4, 12), CFrame = branch * CFrame.new(0, 0, -6),
			Color = C.DarkLeaf, CanCollide = false, Parent = m })
		local tip = branch * CFrame.new(0, 0, -12)
		newPart({ Name = "Feuille", Size = Vector3.new(9, 0.8, 9), CFrame = tip * CFrame.new(0, 1, 0) * CFrame.Angles(0, math.rad(45), 0),
			Color = C.Leaf, Material = Enum.Material.LeafyGrass, CanCollide = false, Parent = m })
		local d = rng:NextNumber(8, 13)
		local color = if rng:NextNumber() < 0.2 then Color3.fromRGB(120, 190, 60) else C.Tomato -- quelques tomates vertes
		newPart({ Name = "Tomate", Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d),
			CFrame = tip * CFrame.new(0, -d / 2 - 0.5, 0), Color = color, Parent = m })
	end
end

function Crops.radish(base)
	local m = group("Radis")
	local d = rng:NextNumber(8, 11)
	ball("Radis", d, base + Vector3.new(0, d * 0.25, 0), C.Radish, m)
	for i = 1, 3 do
		blade("Fane", base + Vector3.new(0, d * 0.7, 0), i * 120, 25, Vector3.new(5, rng:NextNumber(16, 24), 0.8), C.Leaf, m, true)
	end
end

function Crops.pumpkin(base)
	local m = group("Citrouille")
	local d = rng:NextNumber(30, 38)
	for i = 0, 4 do
		local offset = if i == 0 then Vector3.zero else Vector3.new(math.cos(i * math.pi / 2), 0, math.sin(i * math.pi / 2)) * 3
		ball("Cote", d, base + offset + Vector3.new(0, d * 0.38, 0), C.Orange:Lerp(Color3.fromRGB(255, 150, 40), i * 0.1), m)
	end
	vcyl("Pedoncule", 7, 3.5, base + Vector3.new(0, d * 0.85, 0), Color3.fromRGB(100, 120, 50), Enum.Material.Wood, m)
	for i = 1, 3 do
		newPart({ Name = "Feuille", Size = Vector3.new(16, 1, 16), Ellipsoid = true, CanCollide = false, Parent = m,
			CFrame = CFrame.new(base + Vector3.new(0, 1, 0)) * CFrame.Angles(0, math.rad(i * 120), 0) * CFrame.new(0, 0, -d / 2 - 4),
			Color = C.Leaf, Material = Enum.Material.LeafyGrass })
	end
end

function Crops.garlic(base)
	local m = group("Ail")
	local d = rng:NextNumber(12, 16)
	local tint = C.Garlic:Lerp(Color3.fromRGB(200, 160, 200), rng:NextNumber(0, 0.4))
	ball("Tete", d, base + Vector3.new(0, d * 0.3, 0), tint, m)
	for i = 1, 5 do
		local a = i * (math.pi * 2 / 5)
		ball("Gousse", d * 0.55, base + Vector3.new(math.cos(a) * d * 0.35, d * 0.25, math.sin(a) * d * 0.35), tint, m)
	end
	vcyl("Col", 8, d * 0.25, base + Vector3.new(0, d * 0.7, 0), C.Garlic, nil, m)
	for i = 1, 4 do
		blade("Feuille", base + Vector3.new(0, d * 0.7 + 6, 0), i * 90 + rng:NextNumber(-20, 20), rng:NextNumber(5, 18),
			Vector3.new(2.5, rng:NextNumber(40, 58), 0.6), C.GarlicLeaf, m)
	end
end

function Crops.strawberry(base)
	local m = group("Fraisier")
	for i = 1, 6 do
		newPart({ Name = "Feuille", Size = Vector3.new(11, 1, 13), Ellipsoid = true, CanCollide = false, Parent = m,
			CFrame = CFrame.new(base + Vector3.new(0, 6, 0)) * CFrame.Angles(0, math.rad(i * 60), 0) * CFrame.new(0, 0, -6) * CFrame.Angles(math.rad(-15), 0, 0),
			Color = C.Leaf, Material = Enum.Material.LeafyGrass })
	end
	for _ = 1, rng:NextInteger(2, 3) do
		local a = rng:NextNumber(0, math.pi * 2)
		local pos = base + Vector3.new(math.cos(a) * 11, 4.5, math.sin(a) * 11)
		local ripe = rng:NextNumber() < 0.8
		newPart({ Name = "Fraise", Size = Vector3.new(9, 11, 9), Ellipsoid = true, Parent = m,
			CFrame = CFrame.new(pos) * CFrame.Angles(0, a, math.rad(rng:NextNumber(-25, 25))),
			Color = if ripe then C.Strawberry else Color3.fromRGB(240, 240, 200) })
		vcyl("Collerette", 1.2, 6, pos + Vector3.new(0, 5, 0), C.Leaf, nil, m)
	end
end

function Crops.corn(base)
	local m = group("Mais")
	local h = rng:NextNumber(70, 95)
	vcyl("Tige", h, 3.5, base, C.CornLeaf, nil, m)
	for i = 1, 6 do
		blade("Feuille", base + Vector3.new(0, h * (0.15 + i * 0.1), 0), i * 137, rng:NextNumber(45, 65),
			Vector3.new(3, rng:NextNumber(18, 28), 0.5), C.CornLeaf, m)
	end
	local cobY = h * rng:NextNumber(0.45, 0.6)
	local cob = CFrame.new(base + Vector3.new(0, cobY, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0) * CFrame.new(0, 0, -3) * CFrame.Angles(math.rad(-20), 0, 0)
	newPart({ Name = "Epi", Size = Vector3.new(4.5, 15, 4.5), Ellipsoid = true, CFrame = cob, Color = C.Corn, Parent = m })
	newPart({ Name = "Spathe", Size = Vector3.new(5, 10, 5), Ellipsoid = true, CFrame = cob * CFrame.new(0, -3, 0), Color = C.Leaf, CanCollide = false, Parent = m })
	for i = 1, 4 do
		blade("Panicule", base + Vector3.new(0, h, 0), i * 90, 30, Vector3.new(0.6, 8, 0.6), Color3.fromRGB(210, 190, 120), m)
	end
end

function Crops.cabbage(base)
	local m = group("Chou")
	local red = rng:NextNumber() < 0.35
	local color = if red then C.RedCabbage else C.Cabbage
	local d = rng:NextNumber(20, 28)
	ball("Coeur", d, base + Vector3.new(0, d * 0.4, 0), color, m, Enum.Material.LeafyGrass)
	for i = 1, 6 do
		newPart({ Name = "Feuille", Size = Vector3.new(d * 0.8, 2, d), Ellipsoid = true, CanCollide = false, Parent = m,
			CFrame = CFrame.new(base + Vector3.new(0, d * 0.3, 0)) * CFrame.Angles(0, math.rad(i * 60), 0) * CFrame.new(0, 0, -d * 0.45) * CFrame.Angles(math.rad(40), 0, 0),
			Color = color:Lerp(Color3.fromRGB(60, 120, 50), 0.35), Material = Enum.Material.LeafyGrass })
	end
end

local PEPPER_COLORS = { Color3.fromRGB(220, 30, 30), Color3.fromRGB(250, 200, 20), Color3.fromRGB(60, 150, 40), Color3.fromRGB(245, 120, 20) }

function Crops.pepper(base)
	local m = group("Piment")
	local h = rng:NextNumber(22, 32)
	vcyl("Tige", h, 2.5, base, C.DarkLeaf, nil, m)
	for i = 1, 5 do
		blade("Feuille", base + Vector3.new(0, h * (0.4 + i * 0.1), 0), i * 72, 60, Vector3.new(5, 10, 0.6), C.Leaf, m, true)
	end
	for i = 1, rng:NextInteger(2, 4) do
		local a = i * 2.1 + rng:NextNumber()
		local pos = base + Vector3.new(math.cos(a) * 5, h * rng:NextNumber(0.4, 0.8), math.sin(a) * 5)
		local chili = rng:NextNumber() < 0.4
		local size = if chili then Vector3.new(2.5, 11, 2.5) else Vector3.new(7, 9, 7)
		local color = if chili then Color3.fromRGB(200, 15, 15) else PEPPER_COLORS[rng:NextInteger(1, #PEPPER_COLORS)]
		newPart({ Name = if chili then "Piment" else "Poivron", Size = size, Ellipsoid = true, Parent = m,
			CFrame = CFrame.new(pos - Vector3.new(0, size.Y / 2, 0)) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-15, 15))), Color = color })
	end
end

function Crops.sunflower(base)
	local m = group("Tournesol")
	local h = rng:NextNumber(70, 95)
	vcyl("Tige", h, 3, base, C.DarkLeaf, nil, m)
	for i = 1, 3 do
		blade("Feuille", base + Vector3.new(0, h * (0.2 + i * 0.18), 0), i * 120, 70, Vector3.new(10, 14, 0.6), C.Leaf, m, true)
	end
	-- capitule tourné vers l'ouest (soleil couchant), légèrement penché
	local head = CFrame.new(base + Vector3.new(0, h + 2, 0)) * CFrame.Angles(0, math.rad(90 + rng:NextNumber(-25, 25)), 0) * CFrame.Angles(math.rad(-20), 0, 0)
	newPart({ Name = "Coeur", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 20, 20),
		CFrame = head * CFrame.Angles(0, math.rad(90), 0), Color = C.SunflowerHeart, Material = Enum.Material.Sand, Parent = m })
	for i = 0, 13 do
		newPart({ Name = "Petale", Size = Vector3.new(4, 10, 0.6), Ellipsoid = true, CanCollide = false, Parent = m,
			CFrame = head * CFrame.Angles(0, 0, math.rad(i * (360 / 14))) * CFrame.new(0, 13, 0), Color = C.Sunflower })
	end
end

---------------------------------------------------------------------------
-- Décors des sillons
---------------------------------------------------------------------------
local function stone(base)
	local d = rng:NextNumber(5, 12)
	ball("Caillou", d, base + Vector3.new(0, d * 0.25, 0), C.Stone, nil, Enum.Material.Slate)
end

local SEED_COLORS = { Color3.fromRGB(230, 70, 90), Color3.fromRGB(250, 160, 40), Color3.fromRGB(80, 170, 230), Color3.fromRGB(250, 220, 60), Color3.fromRGB(140, 200, 90) }

local function seedPacket(base, text)
	local packet = newPart({ Name = "PaquetDeGraines", Size = Vector3.new(26, 34, 1.5),
		CFrame = CFrame.new(base + Vector3.new(0, 16.5, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), math.rad(rng:NextNumber(-6, 6))),
		Color = SEED_COLORS[rng:NextInteger(1, #SEED_COLORS)] })
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.PixelsPerStud = 10
		gui.Parent = packet
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 0.4)
		label.Position = UDim2.fromScale(0, 0.05)
		label.BackgroundTransparency = 1
		label.Text = text
		label.TextScaled = true
		label.Font = Enum.Font.FredokaOne
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Parent = gui
	end
end

local function strawBale(base)
	newPart({ Name = "BotteDePaille", Size = Vector3.new(22, 14, 14), CFrame = CFrame.new(base + Vector3.new(0, 7, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0),
		Color = C.Straw, Material = Enum.Material.Fabric })
end

---------------------------------------------------------------------------
-- Décors / monuments
---------------------------------------------------------------------------
local Props = {}

function Props.flowerPot(base)
	local m = group("PotDeFleur")
	vcyl("Pot", 24, 28, base, C.Pot, nil, m)
	vcyl("Rebord", 4, 32, base + Vector3.new(0, 22, 0), C.Pot, nil, m)
	vcyl("Terreau", 1, 27, base + Vector3.new(0, 24.6, 0), C.DarkDirt, Enum.Material.Ground, m)
	vcyl("Tige", 55, 2.5, base + Vector3.new(0, 25, 0), C.DarkLeaf, nil, m)
	local top = base + Vector3.new(0, 80, 0)
	local color = Color3.fromHSV(rng:NextNumber(), 0.6, 1)
	ball("Coeur", 8, top, Color3.fromRGB(255, 210, 40), m)
	for i = 0, 7 do
		newPart({ Name = "Petale", Size = Vector3.new(7, 1.5, 15), Ellipsoid = true, CanCollide = false, Parent = m,
			CFrame = CFrame.new(top) * CFrame.Angles(0, math.rad(i * 45), 0) * CFrame.new(0, 0, -9) * CFrame.Angles(math.rad(-15), 0, 0), Color = color })
	end
end

Props.pumpkin = Crops.pumpkin
Props.strawBale = strawBale

function Props.wateringCan(base)
	local m = group("ArrosoirGeant")
	vcyl("Corps", 44, 50, base, C.Metal, Enum.Material.Metal, m)
	vcyl("Bord", 2, 52, base + Vector3.new(0, 44, 0), C.Metal, Enum.Material.Metal, m)
	for _, z in { -14, 14 } do
		newPart({ Name = "Anse", Size = Vector3.new(5, 20, 5), CFrame = CFrame.new(base + Vector3.new(0, 54, z)),
			Color = C.Metal, Material = Enum.Material.Metal, Parent = m })
	end
	newPart({ Name = "Anse", Size = Vector3.new(5, 5, 33), CFrame = CFrame.new(base + Vector3.new(0, 64, 0)),
		Color = C.Metal, Material = Enum.Material.Metal, Parent = m })
	local spout = CFrame.new(base + Vector3.new(24, 10, 0)) * CFrame.Angles(0, 0, math.rad(40))
	newPart({ Name = "Bec", Shape = Enum.PartType.Cylinder, Size = Vector3.new(50, 6, 6), CFrame = spout * CFrame.new(25, 0, 0),
		Color = C.Metal, Material = Enum.Material.Metal, Parent = m })
	newPart({ Name = "Pomme", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 14, 14), CFrame = spout * CFrame.new(51, 0, 0),
		Color = C.Metal, Material = Enum.Material.Metal, Parent = m })
end

function Props.wheelbarrow(base)
	local m = group("BrouetteGeante")
	local red = Color3.fromRGB(190, 40, 35)
	local function box(name, size, offset, color, material)
		newPart({ Name = name, Size = size, CFrame = CFrame.new(base + offset), Color = color or red, Material = material or Enum.Material.Metal, Parent = m })
	end
	box("Fond", Vector3.new(44, 2, 30), Vector3.new(0, 16, 0))
	box("Paroi", Vector3.new(44, 16, 2), Vector3.new(0, 24, 15))
	box("Paroi", Vector3.new(44, 16, 2), Vector3.new(0, 24, -15))
	box("Paroi", Vector3.new(2, 16, 30), Vector3.new(22, 24, 0))
	box("Paroi", Vector3.new(2, 16, 30), Vector3.new(-22, 24, 0))
	box("Terre", Vector3.new(40, 10, 26), Vector3.new(0, 22, 0), C.DarkDirt, Enum.Material.Ground)
	newPart({ Name = "Roue", Shape = Enum.PartType.Cylinder, Size = Vector3.new(5, 20, 20), Parent = m,
		CFrame = CFrame.new(base + Vector3.new(30, 10, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(40, 40, 40) })
	for _, z in { -10, 10 } do
		box("Bras", Vector3.new(70, 2.5, 2.5), Vector3.new(-10, 17, z), C.Wood, Enum.Material.Wood)
		box("Pied", Vector3.new(2.5, 14, 2.5), Vector3.new(-18, 7, z), red)
	end
end

function Props.scarecrow(base)
	local m = group("Epouvantail")
	newPart({ Name = "Poteau", Size = Vector3.new(3, 72, 3), CFrame = CFrame.new(base + Vector3.new(0, 36, 0)), Color = C.Wood, Material = Enum.Material.Wood, Parent = m })
	newPart({ Name = "Bras", Size = Vector3.new(44, 3, 3), CFrame = CFrame.new(base + Vector3.new(0, 56, 0)), Color = C.Wood, Material = Enum.Material.Wood, Parent = m })
	newPart({ Name = "Chemise", Size = Vector3.new(16, 20, 7), CFrame = CFrame.new(base + Vector3.new(0, 50, 0)), Color = Color3.fromRGB(170, 50, 40), Material = Enum.Material.Fabric, Parent = m })
	for _, x in { -14, 14 } do
		newPart({ Name = "Manche", Size = Vector3.new(12, 6, 6), CFrame = CFrame.new(base + Vector3.new(x, 56, 0)), Color = Color3.fromRGB(150, 40, 35), Material = Enum.Material.Fabric, Parent = m })
		blade("Paille", base + Vector3.new(x * 1.45, 56, 0), if x > 0 then 90 else -90, 100, Vector3.new(1, 6, 1), C.Straw, m)
	end
	ball("Tete", 13, base + Vector3.new(0, 67, 0), Color3.fromRGB(200, 170, 120), m, Enum.Material.Fabric)
	vcyl("Bord", 1, 24, base + Vector3.new(0, 72, 0), Color3.fromRGB(110, 80, 40), Enum.Material.Fabric, m)
	vcyl("Chapeau", 9, 12, base + Vector3.new(0, 72, 0), Color3.fromRGB(110, 80, 40), Enum.Material.Fabric, m)
end

function Props.gnome(base)
	-- nain de jardin générique
	local m = group("NainDeJardin")
	vcyl("Bottes", 6, 22, base, Color3.fromRGB(60, 40, 30), nil, m)
	vcyl("Corps", 24, 20, base + Vector3.new(0, 6, 0), Color3.fromRGB(40, 90, 170), nil, m)
	vcyl("Ceinture", 3, 21, base + Vector3.new(0, 14, 0), Color3.fromRGB(40, 30, 20), nil, m)
	ball("Barbe", 16, base + Vector3.new(0, 30, -4), Color3.fromRGB(245, 245, 245), m)
	ball("Visage", 13, base + Vector3.new(0, 36, -1), Color3.fromRGB(250, 205, 170), m)
	ball("Nez", 4, base + Vector3.new(0, 36, -7.5), Color3.fromRGB(240, 150, 130), m)
	local hatColor = Color3.fromRGB(210, 30, 40)
	local y = 40
	for i = 0, 5 do
		local d = 15 - i * 2.4
		vcyl("Bonnet", 4, d, base + Vector3.new(0, y, 0), hatColor, nil, m)
		y += 4
	end
end

