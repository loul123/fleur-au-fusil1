<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><External>null</External><External>nil</External><Item class="ReplicatedStorage" referent="RBX00000006"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000005"><Properties><string name="Name">FleurShared</string></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Configuration partagée (ModuleScript)
	Emplacement : ReplicatedStorage > FleurShared > Config

	Tout le réglage du jeu se fait ici : cadence, dégâts, modes, score, bots.
	Ce module est lu à la fois par le serveur et par les clients.
]]

local Config = {}

Config.ToolName = "FleurAuFusil"
Config.RemotesFolderName = "FleurRemotes"
Config.BotsFolderName = "FleurBots"

---------------------------------------------------------------------------
-- Carte : le potager géant (les personnages paraissent minuscules)
---------------------------------------------------------------------------
