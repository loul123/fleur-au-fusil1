---------------------------------------------------------------------------
-- Structure commune : sol, clôture, spawns, rangs
---------------------------------------------------------------------------
local function buildGround(half, theme)
	newPart({ Name = "Sol", Size = Vector3.new(half * 2 + 300, 10, half * 2 + 300), CFrame = CFrame.new(0, -5, 0),
		Color = theme.Soil or C.Dirt, Material = Enum.Material.Ground })
	newPart({ Name = "Pelouse", Size = Vector3.new(half * 2 + 1200, 9, half * 2 + 1200), CFrame = CFrame.new(0, -5.5, 0),
		Color = C.Grass, Material = Enum.Material.Grass })
end

local function buildFence(half)
	local h = Config.Map.WallHeight
	local fence = group("Cloture")
	local step = 12
	for s = -half, half - step, step do
		local ph = h + rng:NextNumber(-6, 6)
		local c = s + step / 2
		for _, info in {
			{ Vector3.new(c, ph / 2, half + 1.5), Vector3.new(step - 0.6, ph, 3) },
			{ Vector3.new(c, ph / 2, -half - 1.5), Vector3.new(step - 0.6, ph, 3) },
			{ Vector3.new(half + 1.5, ph / 2, c), Vector3.new(3, ph, step - 0.6) },
			{ Vector3.new(-half - 1.5, ph / 2, c), Vector3.new(3, ph, step - 0.6) },
		} do
			newPart({ Name = "Planche", Size = info[2], CFrame = CFrame.new(info[1]),
				Color = C.Wood:Lerp(Color3.fromRGB(110, 75, 45), rng:NextNumber()), Material = Enum.Material.WoodPlanks, Parent = fence })
		end
	end
	-- murs invisibles : impossible de sortir du potager
	for _, info in {
		{ Vector3.new(0, 150, half + 4), Vector3.new(half * 2 + 20, 300, 2) },
		{ Vector3.new(0, 150, -half - 4), Vector3.new(half * 2 + 20, 300, 2) },
		{ Vector3.new(half + 4, 150, 0), Vector3.new(2, 300, half * 2 + 20) },
		{ Vector3.new(-half - 4, 150, 0), Vector3.new(2, 300, half * 2 + 20) },
	} do
		newPart({ Name = "MurInvisible", Size = info[2], CFrame = CFrame.new(info[1]), Transparency = 1, CanQuery = false, Parent = fence })
	end
end

local function makeSpawn(position, teamName)
	local s = Instance.new("SpawnLocation")
	s.Name = "Spawn_" .. (teamName or "Neutre")
	s.Anchored = true
	s.Size = Vector3.new(12, 1, 12)
	s.CFrame = CFrame.lookAt(position, Vector3.new(0, position.Y, 0))
	s.Material = Enum.Material.Grass
	s.Duration = Config.Combat.SpawnProtection
	s.AllowTeamChangeOnTouch = false
	s.TopSurface = Enum.SurfaceType.Smooth
	if teamName then
		for _, t in Config.Teams do
			if t.Name == teamName then
				s.TeamColor = t.BrickColor
				s.BrickColor = t.BrickColor
			end
		end
		spawns[teamName] = spawns[teamName] or {}
		table.insert(spawns[teamName], s)
	else
		s.Color = Color3.fromRGB(240, 240, 200)
		table.insert(spawns.Neutral, s)
	end
	s.Parent = mapFolder
end

local function buildSpawns(half)
	local a, b = Config.Teams[1].Name, Config.Teams[2].Name
	for _, z in { -150, -50, 50, 150 } do
		makeSpawn(Vector3.new(-half + 35, 0.5, z), a)
		makeSpawn(Vector3.new(half - 35, 0.5, z), b)
	end
	for _, pos in {
		Vector3.new(-150, 0.5, half - 25), Vector3.new(0, 0.5, half - 25), Vector3.new(150, 0.5, half - 25),
		Vector3.new(-150, 0.5, -half + 25), Vector3.new(0, 0.5, -half + 25), Vector3.new(150, 0.5, -half + 25),
	} do
		makeSpawn(pos, nil)
	end
end

local function buildGarden(half, theme)
	local rowIndex = 0
	local rowLength = half * 2 - 180
	local spacing = theme.Spacing
	for z = -half + 50, half - 50, 75 do
		rowIndex += 1
		newPart({ Name = "Rang", Size = Vector3.new(rowLength, 3, theme.RowWidth or 24), CFrame = CFrame.new(0, 1.5, z),
			Color = theme.RowColor or C.DarkDirt, Material = theme.RowMaterial or Enum.Material.Ground })

		local rowCrops = theme.Crops
		if theme.CropsPerRow then
			rowCrops = { theme.CropsPerRow[(rowIndex - 1) % #theme.CropsPerRow + 1] }
		end

		local x = -rowLength / 2 + 15
		while x < rowLength / 2 - 15 do
			local pos = Vector3.new(x, 3, z + rng:NextNumber(-3, 3))
			if pos.Magnitude > 60 then -- centre libre pour le monument
				rowCrops[rng:NextInteger(1, #rowCrops)](pos)
			end
			x += rng:NextNumber(spacing[1], spacing[2])
			if theme.GapChance and rng:NextNumber() < theme.GapChance then
				x += theme.GapSize or 20 -- passage (labyrinthe de maïs)
			end
		end

		-- sillon suivant : cailloux et paquets de graines
		local furrowZ = z + 37.5
		if furrowZ < half - 20 then
			for _ = 1, 3 do
				stone(Vector3.new(rng:NextNumber(-half + 100, half - 100), 0, furrowZ + rng:NextNumber(-10, 10)))
			end
			if rng:NextNumber() < 0.7 then
				seedPacket(Vector3.new(rng:NextNumber(-half + 120, half - 120), 0, furrowZ), theme.Seeds)
			end
		end
	end

	theme.Landmark(Vector3.new(0, 0, 0))
	local propPositions = {
		Vector3.new(130, 0, 187.5), Vector3.new(-130, 0, -187.5), Vector3.new(-130, 0, 187.5), Vector3.new(130, 0, -187.5),
		Vector3.new(-half + 75, 0, 100), Vector3.new(-half + 75, 0, -100), Vector3.new(half - 75, 0, 100), Vector3.new(half - 75, 0, -100),
		Vector3.new(0, 0, half - 85), Vector3.new(0, 0, -half + 85), Vector3.new(220, 0, 37.5), Vector3.new(-220, 0, -37.5),
	}
	for i, pos in propPositions do
		theme.Props[(i - 1) % #theme.Props + 1](pos)
	end
end

local function setupLighting(light)
	Lighting.ClockTime = light.ClockTime
	Lighting.Brightness = light.Brightness
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 140)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atmosphere then
		atmosphere = Instance.new("Atmosphere")
		atmosphere.Parent = Lighting
	end
	atmosphere.Color = light.Atmosphere
	atmosphere.Density = light.Density
end

---------------------------------------------------------------------------
-- API
---------------------------------------------------------------------------
local function collectCustomSpawns(container)
	for _, s in container:GetDescendants() do
		if s:IsA("SpawnLocation") then
			local teamName = s.Name:match("^Spawn_(.+)$")
			if teamName and teamName ~= "Neutre" then
				spawns[teamName] = spawns[teamName] or {}
				table.insert(spawns[teamName], s)
			else
				table.insert(spawns.Neutral, s)
			end
		end
	end
end

function MapBuilder.IsGenerated()
	return Config.Map.Generate
end

function MapBuilder.GetCurrentMapId()
	return currentMapId
end

-- Construit (ou reconstruit) la carte `mapId`. Renvoie l'Id réellement chargé.
function MapBuilder.Build(mapId)
	spawns = { Neutral = {} }
	local existing = workspace:FindFirstChild("PotagerGeant")

	if not Config.Map.Generate and existing then
		-- Carte faite à la main : on réutilise ses SpawnLocation (Spawn_<Equipe> ou Spawn_Neutre)
		mapFolder = existing
		collectCustomSpawns(existing)
		currentMapId = "Custom"
		return currentMapId
	end

	if not THEMES[mapId] then
		mapId = "Multi"
	end
	local theme = THEMES[mapId]
	local hash = 0
	for i = 1, #mapId do
		hash = (hash * 31 + string.byte(mapId, i)) % 1000003
	end
	rng = Random.new(Config.Map.Seed + hash)

	if existing then
		existing:Destroy()
	end
	mapFolder = Instance.new("Folder")
	mapFolder.Name = "PotagerGeant"
	mapFolder:SetAttribute("MapId", mapId)

	local half = Config.Map.Size / 2
	buildGround(half, theme)
	buildFence(half)
	buildSpawns(half)
	buildGarden(half, theme)
	setupLighting(theme.Light)
	mapFolder.Parent = workspace -- parenté à la fin : une seule réplication

	-- supprime le Baseplate / SpawnLocation par défaut du template Studio
	for _, name in { "Baseplate", "SpawnLocation" } do
		local obj = workspace:FindFirstChild(name)
		if obj and obj.Parent == workspace then
			obj:Destroy()
		end
	end

	currentMapId = mapId
	MapBuilder.ConfigureSpawns(teamsMode)
	return mapId
end

-- Mode équipe : spawns des camps réservés à leur équipe, spawns neutres coupés.
-- Chacun pour soi : tous les spawns deviennent neutres.
function MapBuilder.ConfigureSpawns(useTeams)
	teamsMode = useTeams
	for key, list in spawns do
		for _, s in list do
			if key == "Neutral" then
				s.Neutral = true
				s.Enabled = not useTeams
			else
				s.Neutral = not useTeams
				s.Enabled = true
			end
		end
	end
end

function MapBuilder.GetSpawnCFrame(teamName)
	local list = {}
	if teamsMode and teamName and spawns[teamName] then
		list = spawns[teamName]
	else
		for _, l in spawns do
			for _, s in l do
				table.insert(list, s)
			end
		end
	end
	if #list == 0 then
		return CFrame.new(0, 10, 0)
	end
	local s = list[rng:NextInteger(1, #list)]
	return s.CFrame * CFrame.new(rng:NextNumber(-4, 4), 4, rng:NextNumber(-4, 4))
end

function MapBuilder.GetRandomPoint()
	local half = Config.Map.Size / 2 - 30
	return Vector3.new(rng:NextNumber(-half, half), 3, rng:NextNumber(-half, half))
end

return MapBuilder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">ParticipantService</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Registre des combattants (ModuleScript serveur)
	Emplacement : ServerScriptService > FleurServer > Modules > ParticipantService

	Un « participant » représente indifféremment un joueur ou un bot :
	  { Id, Name, IsBot, Player, Model, Team, Hits, Taken, RoundHits,
	    RoundTaken, Tier, LastFire, Alive }
	Le modèle du personnage porte l'attribut "FleurId" = participant.Id,
	ce qui permet de retrouver la victime à partir d'une pièce touchée.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("FleurShared"):WaitForChild("Config"))
local Cosmetics = require(ReplicatedStorage:WaitForChild("FleurShared"):WaitForChild("Cosmetics"))

local ParticipantService = {}

local byId = {}
local order = {} -- ordre d'arrivée, pour des itérations stables
local listeners = {}
local botCounter = 0

local function fireChanged()
	for _, fn in listeners do
		task.spawn(fn)
	end
end

function ParticipantService.OnChanged(fn)
	table.insert(listeners, fn)
end

local function newParticipant(id, name, isBot)
	return {
		Id = id,
		Name = name,
		IsBot = isBot,
		Player = nil,
		Model = nil,
		Team = nil,
		Hits = 0,
		Taken = 0,
		RoundHits = 0,
		RoundTaken = 0,
		Tier = Config.DefaultTier,
		LastFire = 0,
		Alive = false,
		Look = Cosmetics.DefaultLook(), -- { WeaponSkin, FlowerSkin, PetalEffect }
	}
end

local function register(p)
	byId[p.Id] = p
	table.insert(order, p.Id)
	fireChanged()
	return p
end

function ParticipantService.AddPlayer(player)
	local p = newParticipant("P" .. player.UserId, player.DisplayName, false)
	p.Player = player

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	for _, statName in { "Score", "Touches", "Reçues" } do
		local v = Instance.new("IntValue")
		v.Name = statName
		v.Parent = stats
	end
	stats.Parent = player
	player:SetAttribute("FleurTier", p.Tier)
	return register(p)
end

function ParticipantService.AddBot(name)
	botCounter += 1
	local p = newParticipant("B" .. botCounter, name, true)
	return register(p)
end

function ParticipantService.Remove(id)
	if byId[id] then
		byId[id] = nil
		local i = table.find(order, id)
		if i then
			table.remove(order, i)
		end
		fireChanged()
	end
end

function ParticipantService.Get(id)
	return byId[id]
end

function ParticipantService.GetByPlayer(player)
	return byId["P" .. player.UserId]
end

function ParticipantService.All()
	local list = {}
	for _, id in order do
		table.insert(list, byId[id])
	end
	return list
end

function ParticipantService.Humans()
	local list = {}
	for _, p in ParticipantService.All() do
		if not p.IsBot then
			table.insert(list, p)
		end
	end
	return list
end

function ParticipantService.Bots()
	local list = {}
	for _, p in ParticipantService.All() do
		if p.IsBot then
			table.insert(list, p)
		end
	end
	return list
end

-- Retrouve le participant propriétaire d'une pièce (membre, accessoire, arme…)
function ParticipantService.FromInstance(instance)
	local model = instance and instance:FindFirstAncestorOfClass("Model")
	while model do
		local id = model:GetAttribute("FleurId")
		if id then
			return byId[id]
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return nil
end

-- Met à jour leaderstats / attributs et prévient les abonnés
function ParticipantService.Sync(p)
	if p.Player and p.Player.Parent then
		local stats = p.Player:FindFirstChild("leaderstats")
		if stats then
			stats.Score.Value = (Config.ComputeScore(p.Hits, p.Taken))
			stats.Touches.Value = p.Hits
			stats["Reçues"].Value = p.Taken
		end
		p.Player:SetAttribute("FleurTier", p.Tier)
	end
	if p.Model then
		p.Model:SetAttribute("FleurTier", p.Tier)
	end
	fireChanged()
end

function ParticipantService.RegisterHit(shooter, victim)
	shooter.Hits += 1
	shooter.RoundHits += 1
	victim.Taken += 1
	victim.RoundTaken += 1
	ParticipantService.Sync(shooter)
	ParticipantService.Sync(victim)
end

function ParticipantService.ResetRound()
	for _, p in ParticipantService.All() do
		p.RoundHits = 0
		p.RoundTaken = 0
	end
	fireChanged()
end

function ParticipantService.ResetMatch()
	for _, p in ParticipantService.All() do
		p.Hits = 0
		p.Taken = 0
		p.RoundHits = 0
		p.RoundTaken = 0
		p.Tier = Config.DefaultTier
		p.LastFire = 0
		ParticipantService.Sync(p)
	end
end

-- Tableau sérialisable envoyé aux clients, trié par score final
function ParticipantService.Snapshot()
	local rows = {}
	for _, p in ParticipantService.All() do
		local final, ratio = Config.ComputeScore(p.Hits, p.Taken)
		table.insert(rows, {
			Id = p.Id,
			Name = p.Name,
			IsBot = p.IsBot,
			Team = p.Team,
			Hits = p.Hits,
			Taken = p.Taken,
			RoundHits = p.RoundHits,
			Score = final,
			Ratio = math.floor(ratio * 100 + 0.5) / 100,
			Tier = p.Tier,
		})
	end
	table.sort(rows, function(a, b)
		if a.Score ~= b.Score then
			return a.Score > b.Score
		end
		return a.Hits > b.Hits
	end)
	return rows
end

return ParticipantService
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX00000016"><Properties><string name="Name">StarterPlayer</string><token name="GameSettingsAvatar">1</token></Properties><Item class="StarterPlayerScripts" referent="RBX00000014"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX00000013"><Properties><string name="Name">FleurClient</string></Properties><Item class="LocalScript" referent="RBX00000010"><Properties><string name="Name">FleurHUD</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Interface de jeu (LocalScript)
	Emplacement : StarterPlayer > StarterPlayerScripts > FleurClient > FleurHUD

	* Bandeau : mode, manche, chrono, objectif, scores d'équipe.
	* Statistiques perso : touches, reçues, ratio, score, fleur (progression Gun Game).
	* Classement en direct (Tab pour l'agrandir), fil des éliminations,
	  annonces et écran de résultats en fin de partie.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local Config = require(ReplicatedStorage:WaitForChild("FleurShared"):WaitForChild("Config"))
local remotes = ReplicatedStorage:WaitForChild(Config.RemotesFolderName)

local myId = "P" .. player.UserId
local state = { Phase = "Waiting", ModeName = "", Objective = "", Round = 0, Rounds = 0, EndsAt = 0, TeamRoundHits = {}, RoundsWon = {}, Teams = false, Target = 0 }
local scoreboard = {}

local FONT = Enum.Font.FredokaOne
local PANEL = Color3.fromRGB(35, 50, 30)

---------------------------------------------------------------------------
-- Aides UI
---------------------------------------------------------------------------
local function make(className, props, parent)
	local obj = Instance.new(className)
	for k, v in props do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function label(props, parent)
	local base = { BackgroundTransparency = 1, Font = FONT, TextColor3 = Color3.new(1, 1, 1), TextScaled = true }
	for k, v in props do
		base[k] = v
	end
	local l = make("TextLabel", base, parent)
	make("UIStroke", { Thickness = 1.5, Color = Color3.fromRGB(20, 30, 15) }, l)
	return l
end

local function panel(props, parent)
	local base = { BackgroundColor3 = PANEL, BackgroundTransparency = 0.25, BorderSizePixel = 0 }
	for k, v in props do
		base[k] = v
	end
	local f = make("Frame", base, parent)
	make("UICorner", { CornerRadius = UDim.new(0, 10) }, f)
	return f
end

local gui = make("ScreenGui", { Name = "FleurHUD", ResetOnSpawn = false, IgnoreGuiInset = false, DisplayOrder = 4 }, player:WaitForChild("PlayerGui"))

---------------------------------------------------------------------------
-- Bandeau supérieur
---------------------------------------------------------------------------
local top = panel({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8), Size = UDim2.fromOffset(460, 92) }, gui)
local modeLabel = label({ Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 4), Text = "La fleur au fusil" }, top)
local timerLabel = label({ Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 30), Text = "", TextColor3 = Color3.fromRGB(255, 235, 120) }, top)
local objectiveLabel = label({ Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(10, 64), Text = "", TextColor3 = Color3.fromRGB(210, 230, 200) }, top)

local teamA = Config.Teams[1]
local teamB = Config.Teams[2]
local teamBar = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 104), Size = UDim2.fromOffset(460, 34), BackgroundTransparency = 1, Visible = false }, gui)
local teamAPanel = panel({ Size = UDim2.new(0.5, -4, 1, 0), BackgroundColor3 = teamA.BrickColor.Color }, teamBar)
local teamALabel = label({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Text = "" }, teamAPanel)
local teamBPanel = panel({ Size = UDim2.new(0.5, -4, 1, 0), Position = UDim2.new(0.5, 4, 0, 0), BackgroundColor3 = teamB.BrickColor.Color }, teamBar)
local teamBLabel = label({ Size = UDim2.new(1, -12, 1, -6), Position = UDim2.fromOffset(6, 3), Text = "" }, teamBPanel)

---------------------------------------------------------------------------
-- Stats perso (bas gauche)
---------------------------------------------------------------------------
local stats = panel({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -12), Size = UDim2.fromOffset(270, 112) }, gui)
local flowerLabel = label({ Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 6), Text = "✿ Pâquerette", TextXAlignment = Enum.TextXAlignment.Left }, stats)
local statsLabel = label({ Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 40), Text = "", TextXAlignment = Enum.TextXAlignment.Left }, stats)
local scoreLabel = label({ Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 66), Text = "", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 235, 120) }, stats)
local progressBack = make("Frame", { Position = UDim2.new(0, 8, 1, -14), Size = UDim2.new(1, -16, 0, 6), BackgroundColor3 = Color3.fromRGB(20, 25, 15), BorderSizePixel = 0 }, stats)
local progressFill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(140, 220, 90), BorderSizePixel = 0 }, progressBack)

---------------------------------------------------------------------------
-- Classement (droite)
---------------------------------------------------------------------------
local board = panel({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8), Size = UDim2.fromOffset(300, 40) }, gui)
label({ Size = UDim2.new(1, -16, 0, 24), Position = UDim2.fromOffset(8, 6), Text = "Classement", TextXAlignment = Enum.TextXAlignment.Left }, board)
local boardHeader = label({ Size = UDim2.new(1, -16, 0, 16), Position = UDim2.fromOffset(8, 30), Text = "", TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Color3.fromRGB(190, 210, 180) }, board)
boardHeader.Text = "Touches  Reçues  Ratio  Score"
local boardRows = {}
local expanded = false

---------------------------------------------------------------------------
-- Annonces, fil d'éliminations, résultats
---------------------------------------------------------------------------
local announceLabel = label({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.32), Size = UDim2.fromOffset(700, 60), Text = "", TextTransparency = 1, TextColor3 = Color3.fromRGB(255, 240, 150) }, gui)
local announceToken = 0

local feed = make("Frame", { Position = UDim2.new(0, 12, 0, 150), Size = UDim2.fromOffset(320, 160), BackgroundTransparency = 1 }, gui)
make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), VerticalAlignment = Enum.VerticalAlignment.Top }, feed)
local feedOrder = 0

local results = panel({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(620, 420), Visible = false, BackgroundTransparency = 0.1 }, gui)
local resultsTitle = label({ Size = UDim2.new(1, -20, 0, 36), Position = UDim2.fromOffset(10, 8), Text = "Résultats" }, results)
local resultsWinner = label({ Size = UDim2.new(1, -20, 0, 30), Position = UDim2.fromOffset(10, 46), Text = "", TextColor3 = Color3.fromRGB(255, 235, 120) }, results)
local resultsBody = make("Frame", { Position = UDim2.fromOffset(16, 86), Size = UDim2.new(1, -32, 1, -130), BackgroundTransparency = 1 }, results)
make("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }, resultsBody)
label({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -20, 0, 30),
	Text = string.format("Score = touches×%d − reçues×%d, multiplié selon le ratio (×%.1f à ×%.1f)",
		Config.Scoring.HitPoints, Config.Scoring.PenaltyPoints, Config.Scoring.MinMultiplier, Config.Scoring.MaxMultiplier),
	TextColor3 = Color3.fromRGB(190, 210, 180) }, results)

---------------------------------------------------------------------------
-- Vote de carte (pendant l'intermission)
---------------------------------------------------------------------------
local votePanel = panel({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -20), Size = UDim2.fromOffset(660, 150), Visible = false }, gui)
label({ Size = UDim2.new(1, -20, 0, 26), Position = UDim2.fromOffset(10, 6), Text = "Votez pour le prochain potager !" }, votePanel)
local voteList = make("Frame", { Position = UDim2.fromOffset(10, 38), Size = UDim2.new(1, -20, 1, -48), BackgroundTransparency = 1 }, votePanel)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center }, voteList)
local voteButtons = {} -- [MapId] = { Button, Votes }
local myVote = nil
local voteKey = ""

local function renderVote()
	local options = state.MapOptions
	votePanel.Visible = state.Phase == "Intermission" and options ~= nil and #options > 0
	if not votePanel.Visible then
		myVote = nil
		return
	end
	local key = ""
	for _, o in options do
		key ..= o.Id .. ";"
	end
	if key ~= voteKey then -- nouvelles propositions : on reconstruit les boutons
		voteKey = key
		myVote = nil
		for _, b in voteButtons do
			b.Button:Destroy()
		end
		table.clear(voteButtons)
		local width = math.floor((640 - 10 * (#options - 1)) / #options)
		for i, o in options do
			local button = make("TextButton", { Size = UDim2.new(0, width, 1, 0), LayoutOrder = i, Text = "", AutoButtonColor = true,
				BackgroundColor3 = Color3.fromRGB(80, 120, 60), BorderSizePixel = 0 }, voteList)
			make("UICorner", { CornerRadius = UDim.new(0, 8) }, button)
			local stroke = make("UIStroke", { Thickness = 0, Color = Color3.fromRGB(255, 235, 120), ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, button)
			label({ Size = UDim2.new(1, -10, 0, 26), Position = UDim2.fromOffset(5, 4), Text = o.Name }, button)
			local desc = label({ Size = UDim2.new(1, -10, 0, 40), Position = UDim2.fromOffset(5, 32), Text = o.Description, TextScaled = false,
				TextSize = 14, TextWrapped = true, TextColor3 = Color3.fromRGB(220, 235, 210) }, button)
			desc.TextYAlignment = Enum.TextYAlignment.Top
			local votes = label({ Size = UDim2.new(1, -10, 0, 20), Position = UDim2.new(0, 5, 1, -24), Text = "0 voix", TextColor3 = Color3.fromRGB(255, 235, 120) }, button)
			button.Activated:Connect(function()
				myVote = o.Id
				remotes.MapVote:FireServer(o.Id)
				renderVote()
			end)
			voteButtons[o.Id] = { Button = button, Votes = votes, Stroke = stroke }
		end
	end
	local counts = state.MapVotes or {}
	for id, b in voteButtons do
		local n = counts[id] or 0
		b.Votes.Text = n .. " voix"
		b.Stroke.Thickness = if myVote == id then 3 else 0
	end
end

---------------------------------------------------------------------------
-- Rendu
---------------------------------------------------------------------------
local function formatTime(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function myRow()
	for _, r in scoreboard do
		if r.Id == myId then
			return r
		end
	end
	return nil
end

local function teamColorOf(teamName)
	for _, t in Config.Teams do
		if t.Name == teamName then
			return t.BrickColor.Color
		end
	end
	return nil
end

local function renderTeams()
	teamBar.Visible = state.Teams and (state.Phase == "Round" or state.Phase == "RoundEnd")
	if not teamBar.Visible then
		return
	end
	local hits = state.TeamRoundHits or {}
	local won = state.RoundsWon or {}
	local function text(t)
		local w = won[t.Name] and won[t.Name].Wins or 0
		return string.format("%s  %d/%d  (manches : %d)", t.Name, hits[t.Name] or 0, state.Target, w)
	end
	teamALabel.Text = text(teamA)
	teamBLabel.Text = text(teamB)
end

local function renderStats()
	local r = myRow()
	local tier = Config.GetTier(player:GetAttribute("FleurTier") or Config.DefaultTier)
	flowerLabel.Text = "✿ " .. tier.Name
	flowerLabel.TextColor3 = tier.PetalColor
	if not r then
		statsLabel.Text = "Touches 0   Reçues 0   Ratio 0"
		scoreLabel.Text = "Score 0"
		progressFill.Size = UDim2.fromScale(0, 1)
		return
	end
	statsLabel.Text = string.format("Touches %d   Reçues %d   Ratio %.2f", r.Hits, r.Taken, r.Ratio)
	local mode = Config.Modes[state.ModeKey or ""]
	if mode and mode.TierEvery then
		local nextIn = mode.TierEvery - (r.RoundHits % mode.TierEvery)
		scoreLabel.Text = string.format("Score %d   •   %d/%d (fleur suivante : %d)", r.Score, r.RoundHits, state.Target, nextIn)
	else
		scoreLabel.Text = string.format("Score %d   •   manche : %d/%d", r.Score, r.RoundHits, state.Target)
	end
	progressFill.Size = UDim2.fromScale(math.clamp(r.RoundHits / math.max(1, state.Target), 0, 1), 1)
end

local function renderBoard()
	for _, row in boardRows do
		row:Destroy()
	end
	table.clear(boardRows)
	local maxRows = if expanded then 16 else 6
	local count = math.min(#scoreboard, maxRows)
	for i = 1, count do
		local r = scoreboard[i]
		local row = make("Frame", { Position = UDim2.fromOffset(8, 50 + (i - 1) * 24), Size = UDim2.new(1, -16, 0, 22),
			BackgroundColor3 = teamColorOf(r.Team) or Color3.fromRGB(70, 90, 60),
			BackgroundTransparency = if r.Id == myId then 0.2 else 0.65, BorderSizePixel = 0 }, board)
		make("UICorner", { CornerRadius = UDim.new(0, 6) }, row)
		label({ Size = UDim2.new(0.45, 0, 1, -4), Position = UDim2.fromOffset(6, 2), TextXAlignment = Enum.TextXAlignment.Left,
			Text = string.format("%d. %s%s", i, if r.IsBot then "🌱" else "", r.Name) }, row)
		label({ Size = UDim2.new(0.55, -8, 1, -4), Position = UDim2.new(0.45, 0, 0, 2), TextXAlignment = Enum.TextXAlignment.Right,
			Text = string.format("%d   %d   %.1f   %d", r.Hits, r.Taken, r.Ratio, r.Score) }, row)
		table.insert(boardRows, row)
	end
	board.Size = UDim2.fromOffset(300, 56 + count * 24)
end

local function renderAll()
	local title = if state.ModeName ~= "" then state.ModeName else "La fleur au fusil"
	if state.MapName and state.MapName ~= "" and state.Phase ~= "Intermission" then
		title ..= " — " .. state.MapName
	end
	modeLabel.Text = title
	renderVote()
	objectiveLabel.Text = state.Objective or ""
	renderTeams()
	renderStats()
	renderBoard()
	if state.Phase == "Intermission" or state.Phase == "Round" then
		results.Visible = false
	end
end

local function announce(text, duration)
	announceToken += 1
	local token = announceToken
	announceLabel.Text = text
	announceLabel.TextTransparency = 0
	announceLabel.Size = UDim2.fromOffset(760, 70)
	TweenService:Create(announceLabel, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(700, 60) }):Play()
	task.delay(duration or 3, function()
		if token == announceToken then
			TweenService:Create(announceLabel, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		end
	end)
end

local function addFeed(text)
	feedOrder += 1
	local entry = panel({ Size = UDim2.new(1, 0, 0, 24), LayoutOrder = -feedOrder, BackgroundTransparency = 0.4 }, feed)
	label({ Size = UDim2.new(1, -12, 1, -4), Position = UDim2.fromOffset(6, 2), Text = text, TextXAlignment = Enum.TextXAlignment.Left }, entry)
	local children = {}
	for _, c in feed:GetChildren() do
		if c:IsA("Frame") then
			table.insert(children, c)
		end
	end
	if #children > 6 then
		table.sort(children, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		children[#children]:Destroy()
	end
	task.delay(7, function()
		if entry.Parent then
			entry:Destroy()
		end
	end)
end

local function showResults(data)
	for _, c in resultsBody:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	resultsTitle.Text = "Résultats — " .. (data.ModeName or "")
	resultsWinner.Text = "Victoire : " .. (data.WinnerLabel or "?") .. "   •   MVP : " .. (data.MVP or "—")
	local header = label({ Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 0, TextXAlignment = Enum.TextXAlignment.Left,
		Text = "#   Nom                                  Touches   Reçues   Ratio   Score final", TextColor3 = Color3.fromRGB(190, 210, 180) }, resultsBody)
	header.TextScaled = false
	header.TextSize = 16
	if data.TeamTotals then
		local i = 0
		for name, t in data.TeamTotals do
			i += 1
			local l = label({ Size = UDim2.new(1, 0, 0, 22), LayoutOrder = i, TextXAlignment = Enum.TextXAlignment.Left,
				Text = string.format("Équipe %s : %d touches, %d reçues, score %d", name, t.Hits, t.Taken, t.Score),
				TextColor3 = teamColorOf(name) or Color3.new(1, 1, 1) }, resultsBody)
			l.TextScaled = false
			l.TextSize = 18
		end
	end
	for i, r in data.Rows or {} do
		if i > 10 then
			break
		end
		local row = make("Frame", { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 10 + i,
			BackgroundColor3 = teamColorOf(r.Team) or Color3.fromRGB(70, 90, 60),
			BackgroundTransparency = if r.Id == myId then 0.2 else 0.6, BorderSizePixel = 0 }, resultsBody)
		make("UICorner", { CornerRadius = UDim.new(0, 6) }, row)
		label({ Size = UDim2.new(0.55, 0, 1, -4), Position = UDim2.fromOffset(6, 2), TextXAlignment = Enum.TextXAlignment.Left,
			Text = string.format("%d.  %s%s", i, if r.IsBot then "🌱 " else "", r.Name) }, row)
		label({ Size = UDim2.new(0.45, -8, 1, -4), Position = UDim2.new(0.55, 0, 0, 2), TextXAlignment = Enum.TextXAlignment.Right,
			Text = string.format("%d     %d     %.2f     %d", r.Hits, r.Taken, r.Ratio, r.Score) }, row)
	end
	results.Visible = true
end

---------------------------------------------------------------------------
-- Réseau
---------------------------------------------------------------------------
remotes:WaitForChild("GameState").OnClientEvent:Connect(function(s)
	state = s
	renderAll()
end)

remotes:WaitForChild("Scoreboard").OnClientEvent:Connect(function(rows, teamHits)
	scoreboard = rows
	if teamHits then
		state.TeamRoundHits = teamHits
	end
	renderAll()
end)

remotes:WaitForChild("Announce").OnClientEvent:Connect(announce)

remotes:WaitForChild("KillFeed").OnClientEvent:Connect(function(shooterName, victimName, flowerName)
	addFeed(string.format("%s ✿ %s  (%s)", shooterName, victimName, flowerName))
end)

remotes:WaitForChild("MatchResults").OnClientEvent:Connect(showResults)

player:GetAttributeChangedSignal("FleurTier"):Connect(renderStats)

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.Tab then
		expanded = not expanded
		renderBoard()
	end
end)

task.spawn(function()
	local ok, s, rows = pcall(function()
		return remotes:WaitForChild("GetState"):InvokeServer()
	end)
	if ok and s then
		state = s
		scoreboard = rows or {}
		renderAll()
	end
end)

-- Chronomètre
RunService.Heartbeat:Connect(function()
	local remaining = (state.EndsAt or 0) - workspace:GetServerTimeNow()
	local phase = state.Phase
	if phase == "Waiting" then
		timerLabel.Text = "En attente de joueurs…"
	elseif phase == "Intermission" then
		timerLabel.Text = "Début dans " .. formatTime(remaining)
	elseif phase == "Round" then
		local roundText = if (state.Rounds or 1) > 1 then string.format("Manche %d/%d   ", state.Round, state.Rounds) else ""
		timerLabel.Text = roundText .. formatTime(remaining)
	elseif phase == "RoundEnd" then
		timerLabel.Text = "Manche suivante dans " .. formatTime(remaining)
	elseif phase == "MatchEnd" then
		timerLabel.Text = "Partie terminée — " .. formatTime(remaining)
	end
end)

renderAll()
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000011"><Properties><string name="Name">FleurPass</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Pass de saison & casier (LocalScript)
	Emplacement : StarterPlayer > StarterPlayerScripts > FleurClient > FleurPass

	* Bouton « Pass » (touche B) : paliers gratuits / premium, progression en
	  graines, achat du Pass Premium (Game Pass).
	* Onglet Sachets : ouvrir des sachets de graines (tirage d'une fleur,
	  probabilités affichées), en stock ou payés avec le solde de graines.
	* Onglet Casier : aperçu 3D de l'arme, équiper skins d'arme, fleurs et
	  animations de pétales possédés.
	* Fenêtres « +N graines » en fin de partie et « Nouvelle récompense ».
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local MarketplaceService = game:GetService("MarketplaceService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("FleurShared")
local Config = require(Shared:WaitForChild("Config"))
local Cosmetics = require(Shared:WaitForChild("Cosmetics"))
local WeaponFactory = require(Shared:WaitForChild("WeaponFactory"))
local remotes = ReplicatedStorage:WaitForChild(Config.RemotesFolderName)

local BP = Config.BattlePass
local FONT = Enum.Font.FredokaOne
local PANEL = Color3.fromRGB(35, 50, 30)
local GOLD = Color3.fromRGB(255, 200, 60)

local profile = { Seeds = 0, SeedBalance = 0, Packs = {}, Premium = false, Owned = {}, Equipped = Cosmetics.DefaultLook() }
local ownedSet = {}
local premiumPrice = nil
local productPrices = {} -- [Key] = prix en Robux

---------------------------------------------------------------------------
-- Aides UI
---------------------------------------------------------------------------
local function make(className, props, parent)
	local obj = Instance.new(className)
	for k, v in props do
		obj[k] = v
	end
	obj.Parent = parent
	return obj
end

local function corner(parent, r)
	make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, parent)
end

local function label(props, parent)
	local base = { BackgroundTransparency = 1, Font = FONT, TextColor3 = Color3.new(1, 1, 1), TextScaled = true }
	for k, v in props do
		base[k] = v
	end
	local l = make("TextLabel", base, parent)
	make("UIStroke", { Thickness = 1.2, Color = Color3.fromRGB(20, 30, 15) }, l)
	return l
end

local function button(props, parent)
	local base = { Font = FONT, TextColor3 = Color3.new(1, 1, 1), TextScaled = true, BorderSizePixel = 0, AutoButtonColor = true,
		BackgroundColor3 = Color3.fromRGB(80, 130, 60) }
	for k, v in props do
		base[k] = v
	end
	local b = make("TextButton", base, parent)
	corner(b)
	return b
end

local function clear(container)
	for _, c in container:GetChildren() do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

local function isOwned(typeName, id)
	return ownedSet[Cosmetics.Key(typeName, id)] == true or Cosmetics.IsDefault(typeName, id)
end

local function swatches(item, parent, size)
	local colors
	if item.Type == "WeaponSkin" then
		colors = { item.Body, item.Accent, item.Metal }
	elseif item.Type == "FlowerSkin" then
		colors = if item.PetalColors then { item.PetalColors[1], item.PetalColors[2], item.PetalColors[3] or item.HeartColor }
			else { item.PetalColor, item.PetalColor2 or item.HeartColor }
	elseif item.Type == "Pack" then
		colors = { item.Color }
	else
		colors = nil
	end
	local holder = make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, size) }, parent)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4) }, holder)
	if colors then
		for _, c in colors do
			local dot = make("Frame", { Size = UDim2.fromOffset(size, size), BackgroundColor3 = c, BorderSizePixel = 0 }, holder)
			corner(dot, size)
			make("UIStroke", { Color = Color3.fromRGB(20, 20, 20), Thickness = 1 }, dot)
		end
	else
		label({ Size = UDim2.fromOffset(size * 3, size), Text = "✨🌸✨" }, holder)
	end
	return holder
end

---------------------------------------------------------------------------
-- Fenêtre principale
---------------------------------------------------------------------------
local gui = make("ScreenGui", { Name = "FleurPassGui", ResetOnSpawn = false, DisplayOrder = 10 }, player:WaitForChild("PlayerGui"))

local openButton = button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12), Size = UDim2.fromOffset(170, 46),
	Text = "🌱 Pass (B)", BackgroundColor3 = Color3.fromRGB(60, 120, 50) }, gui)

local window = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(820, 500),
	BackgroundColor3 = PANEL, BackgroundTransparency = 0.05, Visible = false }, gui)
corner(window, 14)
make("UIStroke", { Color = Color3.fromRGB(140, 200, 100), Thickness = 2 }, window)

local title = label({ Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -200, 0, 30), Text = BP.SeasonName, TextXAlignment = Enum.TextXAlignment.Left }, window)
local closeButton = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(36, 36), Text = "✕",
	BackgroundColor3 = Color3.fromRGB(170, 60, 60) }, window)
local tabPass = button({ Position = UDim2.fromOffset(16, 48), Size = UDim2.fromOffset(170, 32), Text = "Pass de saison" }, window)
local tabPacks = button({ Position = UDim2.fromOffset(194, 48), Size = UDim2.fromOffset(130, 32), Text = "Sachets" }, window)
local tabLocker = button({ Position = UDim2.fromOffset(332, 48), Size = UDim2.fromOffset(130, 32), Text = "Casier" }, window)
local balanceLabel = label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -56, 0, 50), Size = UDim2.fromOffset(300, 28), Text = "",
	TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Color3.fromRGB(180, 240, 140) }, window)

local pagePass = make("Frame", { Position = UDim2.fromOffset(0, 88), Size = UDim2.new(1, 0, 1, -88), BackgroundTransparency = 1 }, window)
local pageLocker = make("Frame", { Position = UDim2.fromOffset(0, 88), Size = UDim2.new(1, 0, 1, -88), BackgroundTransparency = 1, Visible = false }, window)
local pagePacks = make("Frame", { Position = UDim2.fromOffset(0, 88), Size = UDim2.new(1, 0, 1, -88), BackgroundTransparency = 1, Visible = false }, window)

---------------------------------------------------------------------------
-- Onglet Pass
---------------------------------------------------------------------------
local seedsLabel = label({ Position = UDim2.fromOffset(16, 0), Size = UDim2.fromOffset(330, 30), Text = "🌱 0 graines", TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.fromRGB(180, 240, 140) }, pagePass)
local progressText = label({ Position = UDim2.fromOffset(16, 32), Size = UDim2.fromOffset(440, 20), Text = "", TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = Color3.fromRGB(210, 230, 200) }, pagePass)
local barBack = make("Frame", { Position = UDim2.fromOffset(16, 56), Size = UDim2.fromOffset(440, 10), BackgroundColor3 = Color3.fromRGB(20, 25, 15), BorderSizePixel = 0 }, pagePass)
corner(barBack, 5)
local barFill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(140, 220, 90), BorderSizePixel = 0 }, barBack)
corner(barFill, 5)

local premiumButton = button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 0), Size = UDim2.fromOffset(330, 52),
	Text = "Débloquer le Pass Premium", BackgroundColor3 = Color3.fromRGB(200, 140, 20) }, pagePass)
make("UIStroke", { Color = GOLD, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, premiumButton)

label({ Position = UDim2.fromOffset(16, 76), Size = UDim2.fromOffset(420, 20), Text = "En haut : piste gratuite  •  En bas : piste premium ✿",
	TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = GOLD }, pagePass)

local track = make("ScrollingFrame", { Position = UDim2.fromOffset(16, 100), Size = UDim2.new(1, -32, 1, -112), BackgroundTransparency = 1,
	ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 8, AutomaticCanvasSize = Enum.AutomaticSize.X,
	CanvasSize = UDim2.new(0, 0, 0, 0), BorderSizePixel = 0 }, pagePass)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, track)

local function rewardCard(reward, unlocked, isPremium, parent, order)
	local card = make("Frame", { Size = UDim2.new(1, 0, 0, 130), LayoutOrder = order, BorderSizePixel = 0,
		BackgroundColor3 = if isPremium then Color3.fromRGB(70, 55, 20) else Color3.fromRGB(45, 65, 40) }, parent)
	corner(card)
	make("UIStroke", { Color = if isPremium then GOLD else Color3.fromRGB(110, 150, 90), Thickness = if unlocked then 3 else 1 }, card)
	if not reward then
		label({ Size = UDim2.fromScale(1, 1), Text = "—", TextColor3 = Color3.fromRGB(120, 140, 110) }, card)
		return card
	end
	local item
	if reward.Type == "Pack" then
		local pack = Cosmetics.GetPack(reward.Id)
		item = { Type = "Pack", Name = string.format("%s ×%d", pack.Name, reward.Count or 1), Color = pack.Color,
			Rarity = if pack.Id == "SachetDore" then "Legendaire" else "Rare" }
	else
		item = Cosmetics.Get(reward.Type, reward.Id)
	end
	local rarity = Cosmetics.Rarities[item.Rarity] or Cosmetics.Rarities.Commune
	make("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }, card)
	make("UIListLayout", { HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, card)
	label({ Size = UDim2.new(1, 0, 0, 14), Text = if reward.Type == "Pack" then "Sachet" else Cosmetics.TypeLabels[reward.Type], TextColor3 = Color3.fromRGB(200, 210, 190), LayoutOrder = 1 }, card)
	swatches(item, card, 18).LayoutOrder = 2
	label({ Size = UDim2.new(1, 0, 0, 34), Text = item.Name, TextWrapped = true, LayoutOrder = 3 }, card)
	label({ Size = UDim2.new(1, 0, 0, 14), Text = rarity.Label, TextColor3 = rarity.Color, LayoutOrder = 4 }, card)
	local state = if unlocked then "✔ Obtenu" elseif isPremium and not profile.Premium then "🔒 Premium" else "🔒"
	label({ Size = UDim2.new(1, 0, 0, 18), Text = state, LayoutOrder = 5,
		TextColor3 = if unlocked then Color3.fromRGB(140, 240, 120) else Color3.fromRGB(220, 200, 180) }, card)
	return card
end

local function renderPass()
	clear(track)
	local seeds = profile.Seeds or 0
	local reached = 0
	for i, tier in BP.Tiers do
		if seeds >= tier.Seeds then
			reached = i
		end
		local column = make("Frame", { Size = UDim2.new(0, 120, 1, -10), BackgroundTransparency = 1, LayoutOrder = i }, track)
		make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, column)
		local done = seeds >= tier.Seeds
		rewardCard(tier.Free, done, false, column, 1)
		label({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2, Text = string.format("%d • 🌱%d", i, tier.Seeds),
			TextColor3 = if done then Color3.fromRGB(180, 240, 140) else Color3.fromRGB(200, 200, 200) }, column)
		rewardCard(tier.Premium, done and profile.Premium, true, column, 3)
	end

	seedsLabel.Text = string.format("Progression : 🌱 %d graines", seeds)
	local nextTier = BP.Tiers[reached + 1]
	if nextTier then
		local from = if reached > 0 then BP.Tiers[reached].Seeds else 0
		progressText.Text = string.format("Palier %d/%d — encore %d graines pour le palier %d", reached, #BP.Tiers, nextTier.Seeds - seeds, reached + 1)
		barFill.Size = UDim2.fromScale(math.clamp((seeds - from) / math.max(1, nextTier.Seeds - from), 0, 1), 1)
	else
		progressText.Text = string.format("Pass terminé ! (%d/%d paliers)", reached, #BP.Tiers)
		barFill.Size = UDim2.fromScale(1, 1)
	end

	if profile.Premium then
		premiumButton.Text = "✿ PASS PREMIUM ACTIF ✿"
		premiumButton.AutoButtonColor = false
		premiumButton.BackgroundColor3 = Color3.fromRGB(150, 110, 20)
	else
		premiumButton.Text = string.format("Débloquer le Pass Premium%s  (+%d%% graines)",
			if premiumPrice then " — R$ " .. premiumPrice else "", math.floor(BP.PremiumSeedBonus * 100 + 0.5))
	end
	openButton.Text = string.format("🌱 %d  •  Pass (B)", profile.SeedBalance or 0)
	balanceLabel.Text = string.format("Solde : 🌱 %d graines", profile.SeedBalance or 0)
end

premiumButton.Activated:Connect(function()
	if not profile.Premium then
		remotes.BuyPremium:FireServer()
	end
end)

---------------------------------------------------------------------------
-- Onglet Casier (avec aperçu 3D de l'arme)
---------------------------------------------------------------------------
local viewport = make("ViewportFrame", { Position = UDim2.fromOffset(16, 0), Size = UDim2.fromOffset(330, 300), BackgroundColor3 = Color3.fromRGB(225, 228, 232),
	Ambient = Color3.fromRGB(170, 170, 170), LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(-1, -1, -0.5) }, pageLocker)
corner(viewport, 12)
local viewportCamera = make("Camera", { FieldOfView = 30 }, viewport)
viewport.CurrentCamera = viewportCamera
local previewModel = nil
local previewKey = ""
local previewAngle = 0
local lookLabel = label({ Position = UDim2.fromOffset(16, 306), Size = UDim2.fromOffset(330, 60), Text = "", TextWrapped = true,
	TextColor3 = Color3.fromRGB(210, 230, 200) }, pageLocker)

local function refreshPreview()
	local look = profile.Equipped
	local key = look.WeaponSkin .. look.FlowerSkin
	if key == previewKey and previewModel then
		return
	end
	previewKey = key
	if previewModel then
		previewModel:Destroy()
	end
	previewModel = WeaponFactory.CreatePreview(look)
	previewModel.Parent = viewport
	local effect = Cosmetics.Get("PetalEffect", look.PetalEffect)
	lookLabel.Text = string.format("%s\n%s • %s", Cosmetics.Get("WeaponSkin", look.WeaponSkin).Name,
		Cosmetics.Get("FlowerSkin", look.FlowerSkin).Name, effect.Name)
end

local lists = make("ScrollingFrame", { Position = UDim2.fromOffset(362, 0), Size = UDim2.new(1, -378, 1, -12), BackgroundTransparency = 1,
	ScrollBarThickness = 8, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(0, 0, 0, 0), BorderSizePixel = 0 }, pageLocker)
make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, lists)

local function renderLocker()
	clear(lists)
	local order = 0
	for _, typeName in Cosmetics.Types do
		order += 1
		label({ Size = UDim2.new(1, -10, 0, 24), LayoutOrder = order, Text = Cosmetics.TypeLabels[typeName], TextXAlignment = Enum.TextXAlignment.Left }, lists)
		order += 1
		local grid = make("Frame", { Size = UDim2.new(1, -10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order }, lists)
		make("UIGridLayout", { CellSize = UDim2.fromOffset(136, 74), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		for i, item in Cosmetics.List(typeName) do
			local owned = isOwned(typeName, item.Id)
			local equipped = profile.Equipped[typeName] == item.Id
			local rarity = Cosmetics.Rarities[item.Rarity] or Cosmetics.Rarities.Commune
			local cell = button({ Text = "", LayoutOrder = rarity.Order * 100 + i, AutoButtonColor = owned,
				BackgroundColor3 = if owned then Color3.fromRGB(55, 80, 45) else Color3.fromRGB(45, 45, 45) }, grid)
			make("UIStroke", { Color = if equipped then Color3.fromRGB(140, 255, 120) else rarity.Color, Thickness = if equipped then 3 else 1,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, cell)
			local swatch = swatches(item, cell, 14)
			swatch.Position = UDim2.fromOffset(0, 6)
			label({ Position = UDim2.fromOffset(4, 24), Size = UDim2.new(1, -8, 0, 26),
				Text = if item.Number then string.format("#%d %s", item.Number, item.Name) else item.Name, TextWrapped = true,
				TextTransparency = if owned then 0 else 0.4 }, cell)
			label({ Position = UDim2.fromOffset(4, 52), Size = UDim2.new(1, -8, 0, 16),
				Text = if equipped then "Équipé" elseif owned then rarity.Label else "🔒 Pass de saison",
				TextColor3 = if equipped then Color3.fromRGB(140, 255, 120) else rarity.Color }, cell)
			cell.Activated:Connect(function()
				if owned and not equipped then
					remotes.EquipCosmetic:FireServer(typeName, item.Id)
				end
			end)
		end
	end
	refreshPreview()
end

RunService.RenderStepped:Connect(function(dt)
	if not (window.Visible and pageLocker.Visible and previewModel) then
		return
	end
	previewAngle += dt * 0.6
	local radius = 12
	local pos = Vector3.new(math.sin(previewAngle) * radius, 1.5, math.cos(previewAngle) * radius)
	viewportCamera.CFrame = CFrame.lookAt(pos, Vector3.new(0, 0, -0.9))
end)

---------------------------------------------------------------------------
-- Onglet Sachets (tirage d'une fleur)
---------------------------------------------------------------------------
local packList = make("Frame", { Position = UDim2.fromOffset(16, 0), Size = UDim2.fromOffset(470, 400), BackgroundTransparency = 1 }, pagePacks)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10) }, packList)

local reveal = make("Frame", { Position = UDim2.fromOffset(500, 0), Size = UDim2.new(1, -516, 1, -12), BackgroundColor3 = Color3.fromRGB(25, 35, 22) }, pagePacks)
corner(reveal, 12)
local revealStroke = make("UIStroke", { Color = Color3.fromRGB(110, 150, 90), Thickness = 2 }, reveal)
local revealViewport = make("ViewportFrame", { Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 200), BackgroundTransparency = 1,
	Ambient = Color3.fromRGB(180, 180, 180), LightDirection = Vector3.new(-1, -1, -0.5) }, reveal)
local revealCamera = make("Camera", { FieldOfView = 30 }, revealViewport)
revealViewport.CurrentCamera = revealCamera
revealCamera.CFrame = CFrame.lookAt(Vector3.new(6, 0.2, -3.0), Vector3.new(0, 0.05, -3.0)) -- gros plan sur la fleur (vue de profil)
local revealName = label({ Position = UDim2.fromOffset(10, 216), Size = UDim2.new(1, -20, 0, 30), Text = "Ouvrez un sachet !" }, reveal)
local revealRarity = label({ Position = UDim2.fromOffset(10, 248), Size = UDim2.new(1, -20, 0, 24), Text = "" }, reveal)
local revealInfo = label({ Position = UDim2.fromOffset(10, 276), Size = UDim2.new(1, -20, 0, 40), Text = "", TextWrapped = true,
	TextColor3 = Color3.fromRGB(210, 230, 200) }, reveal)
local revealModel = nil
local rolling = false

local function showFlower(flowerId)
	if revealModel then
		revealModel:Destroy()
	end
	local look = table.clone(profile.Equipped)
	look.FlowerSkin = flowerId
	revealModel = WeaponFactory.CreatePreview(look)
	revealModel.Parent = revealViewport
	local flower = Cosmetics.Get("FlowerSkin", flowerId)
	local rarity = Cosmetics.Rarities[flower.Rarity] or Cosmetics.Rarities.Commune
	revealName.Text = string.format("#%d %s", flower.Number or 0, flower.Name)
	revealRarity.Text = rarity.Label
	revealRarity.TextColor3 = rarity.Color
	revealStroke.Color = rarity.Color
end

local function oddsText(pack)
	local lines = {}
	for _, rarityName in Cosmetics.RarityOrder do
		local pct = pack.Odds[rarityName]
		if pct then
			table.insert(lines, string.format("%s : %s %%", Cosmetics.Rarities[rarityName].Label, tostring(pct)))
		end
	end
	return table.concat(lines, "\n")
end

renderPacks = function()
	clear(packList)
	for _, pack in Cosmetics.Packs do
		local stock = (profile.Packs and profile.Packs[pack.Id]) or 0
		local card = make("Frame", { Size = UDim2.fromOffset(230, 395), BackgroundColor3 = Color3.fromRGB(45, 65, 40) }, packList)
		corner(card, 12)
		make("UIStroke", { Color = pack.Color, Thickness = 2 }, card)
		label({ Position = UDim2.fromOffset(8, 8), Size = UDim2.new(1, -16, 0, 28), Text = pack.Name, TextColor3 = pack.Color }, card)
		label({ Position = UDim2.fromOffset(8, 40), Size = UDim2.new(1, -16, 0, 20),
			Text = string.format("En stock : %d   •   Prix : 🌱 %d", stock, pack.Price) }, card)
		local odds = label({ Position = UDim2.fromOffset(12, 66), Size = UDim2.new(1, -24, 0, 175), Text = "Probabilités :\n" .. oddsText(pack),
			TextScaled = false, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = Color3.fromRGB(215, 230, 205) }, card)
		odds.TextWrapped = true

		-- Achat en Robux (Developer Products)
		local products = {}
		for _, product in Config.Shop.Products do
			if product.PackId == pack.Id then
				table.insert(products, product)
			end
		end
		if profile.PaidRandomRestricted then
			label({ Position = UDim2.fromOffset(10, 250), Size = UDim2.new(1, -20, 0, 34), Text = "Achat en Robux indisponible dans votre pays",
				TextWrapped = true, TextColor3 = Color3.fromRGB(220, 200, 180) }, card)
		elseif #products > 0 then
			label({ Position = UDim2.fromOffset(10, 246), Size = UDim2.new(1, -20, 0, 18), Text = "Acheter avec des Robux :", TextColor3 = GOLD }, card)
			local width = math.floor((210 - 6 * (#products - 1)) / #products)
			for i, product in products do
				local price = productPrices[product.Key]
				local buy = button({ Position = UDim2.fromOffset(10 + (i - 1) * (width + 6), 268), Size = UDim2.fromOffset(width, 50),
					Text = string.format("%s\n%s", product.Label, if price then "R$ " .. price elseif product.ProductId == 0 then "R$ (test)" else "R$ …"),
					BackgroundColor3 = Color3.fromRGB(0, 140, 70) }, card)
				make("UIStroke", { Color = GOLD, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, buy)
				buy.Activated:Connect(function()
					remotes.BuyProduct:FireServer(product.Key)
				end)
			end
		end
		local canOpen = stock > 0 or (profile.SeedBalance or 0) >= pack.Price
		local open = button({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -20, 0, 46),
			Text = if stock > 0 then "Ouvrir (en stock)" else string.format("Ouvrir — 🌱 %d", pack.Price),
			BackgroundColor3 = if canOpen then Color3.fromRGB(80, 150, 60) else Color3.fromRGB(80, 80, 80), AutoButtonColor = canOpen }, card)
		open.Activated:Connect(function()
			if canOpen and not rolling then
				rolling = true
				revealInfo.Text = "Ouverture…"
				remotes.OpenPack:FireServer(pack.Id)
				task.delay(5, function()
					rolling = false -- sécurité si le serveur ne répond pas
				end)
			end
		end)
	end
end

remotes:WaitForChild("PackResult").OnClientEvent:Connect(function(result)
	if result.Error then
		rolling = false
		revealInfo.Text = result.Error
		return
	end
	-- petite animation : défilement de fleurs avant la vraie
	local pool = Cosmetics.List("FlowerSkin")
	for i = 1, 14 do
		showFlower(pool[math.random(1, #pool)].Id)
		task.wait(0.05 + i * 0.012)
	end
	showFlower(result.FlowerId)
	revealInfo.Text = if result.Duplicate then string.format("Doublon : +%d graines remboursées", result.Refund) else "Nouvelle fleur ajoutée au casier !"
	rolling = false
	if pagePacks.Visible then
		renderPacks()
	end
end)

---------------------------------------------------------------------------
-- Navigation
---------------------------------------------------------------------------
local renderPacks -- défini plus bas
local currentTab = "Pass"

local function showTab(name)
	currentTab = name
	pagePass.Visible = name == "Pass"
	pagePacks.Visible = name == "Packs"
	pageLocker.Visible = name == "Locker"
	for tabName, b in { Pass = tabPass, Packs = tabPacks, Locker = tabLocker } do
		b.BackgroundColor3 = if name == tabName then Color3.fromRGB(110, 170, 80) else Color3.fromRGB(70, 100, 55)
	end
	if name == "Pass" then
		renderPass()
	elseif name == "Packs" then
		renderPacks()
	else
		renderLocker()
	end
end

local function toggle(open)
	window.Visible = if open == nil then not window.Visible else open
	if window.Visible then
		showTab(currentTab)
	end
end

openButton.Activated:Connect(function()
	toggle()
end)
closeButton.Activated:Connect(function()
	toggle(false)
end)
tabPass.Activated:Connect(function()
	showTab("Pass")
end)
tabPacks.Activated:Connect(function()
	showTab("Packs")
end)
tabLocker.Activated:Connect(function()
	showTab("Locker")
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.B then
		toggle()
	end
end)

---------------------------------------------------------------------------
-- Notifications : graines gagnées, nouvelles récompenses
---------------------------------------------------------------------------
local toastHolder = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -190), Size = UDim2.fromOffset(380, 300),
	BackgroundTransparency = 1 }, gui)
make("UIListLayout", { VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Center,
	Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, toastHolder)
local toastOrder = 0

local function toast(lines, accent, duration)
	toastOrder += 1
	local frame = make("Frame", { Size = UDim2.new(1, 0, 0, 16 + #lines * 24), BackgroundColor3 = PANEL, BackgroundTransparency = 0.1, LayoutOrder = toastOrder }, toastHolder)
	corner(frame, 10)
	make("UIStroke", { Color = accent, Thickness = 2 }, frame)
	for i, text in lines do
		label({ Position = UDim2.fromOffset(10, 8 + (i - 1) * 24), Size = UDim2.new(1, -20, 0, if i == 1 then 24 else 20), Text = text,
			TextColor3 = if i == 1 then accent else Color3.new(1, 1, 1) }, frame)
	end
	task.delay(duration or 7, function()
		if frame.Parent then
			TweenService:Create(frame, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			task.wait(0.4)
			frame:Destroy()
		end
	end)
end

remotes:WaitForChild("SeedsAwarded").OnClientEvent:Connect(function(data)
	local lines = { string.format("+%d graines 🌱  %s", data.Amount, if data.Won then "(Victoire !)" else "") }
	for _, line in data.Lines or {} do
		table.insert(lines, string.format("%s : %s%d", line.Label, if line.Amount >= 0 then "+" else "", line.Amount))
	end
	if data.TierAfter > data.TierBefore then
		table.insert(lines, string.format("Palier %d atteint ! Ouvrez le Pass (B)", data.TierAfter))
	end
	toast(lines, Color3.fromRGB(150, 240, 110), 9)
end)

remotes:WaitForChild("Unlocked").OnClientEvent:Connect(function(items, message)
	if message then
		toast({ message }, GOLD, 6)
	end
	for _, item in items or {} do
		local rarity = Cosmetics.Rarities[item.Rarity] or Cosmetics.Rarities.Commune
		toast({ "Nouvelle récompense !", string.format("%s : %s (%s)", Cosmetics.TypeLabels[item.Type] or "", item.Name, rarity.Label) }, rarity.Color, 8)
	end
end)

remotes:WaitForChild("Profile").OnClientEvent:Connect(function(data)
	profile = data
	table.clear(ownedSet)
	for _, key in data.Owned or {} do
		ownedSet[key] = true
	end
	title.Text = BP.SeasonName .. (if data.Saved == false then "  (non sauvegardé)" else "")
	renderPass()
	if window.Visible and pageLocker.Visible then
		renderLocker()
	elseif window.Visible and pagePacks.Visible then
		renderPacks()
	end
end)

task.spawn(function()
	for _, product in Config.Shop.Products do
		if product.ProductId ~= 0 then
			local ok, info = pcall(function()
				return MarketplaceService:GetProductInfo(product.ProductId, Enum.InfoType.Product)
			end)
			if ok and info and info.PriceInRobux then
				productPrices[product.Key] = info.PriceInRobux
			end
		end
	end
	if window.Visible and pagePacks.Visible then
		renderPacks()
	end
end)

task.spawn(function()
	if BP.GamePassId and BP.GamePassId > 0 then
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(BP.GamePassId, Enum.InfoType.GamePass)
		end)
		if ok and info and info.PriceInRobux then
			premiumPrice = info.PriceInRobux
			renderPass()
		end
	end
end)

renderPass()
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX00000012"><Properties><string name="Name">FleurWeapon</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Arme côté client (LocalScript)
	Emplacement : StarterPlayer > StarterPlayerScripts > FleurClient > FleurWeapon

	* Clic gauche (ou tap sur mobile) = tirer un pétale ; maintenir = tir continu
	  à la cadence de la fleur (cooldown appliqué aussi côté serveur).
	* Affiche immédiatement les pétales du joueur (pas d'attente réseau) et ceux
	  des autres combattants diffusés par le serveur.
	* Viseur, barre de recharge, hitmarker et flash quand on est touché.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("FleurShared")
local Config = require(shared:WaitForChild("Config"))
local PetalVisual = require(shared:WaitForChild("PetalVisual"))
local Cosmetics = require(shared:WaitForChild("Cosmetics"))

local remotes = ReplicatedStorage:WaitForChild(Config.RemotesFolderName)
local FireRequest = remotes:WaitForChild("FireRequest")
local PetalFired = remotes:WaitForChild("PetalFired")
local HitConfirm = remotes:WaitForChild("HitConfirm")
local HitTaken = remotes:WaitForChild("HitTaken")
local GameState = remotes:WaitForChild("GameState")

local myId = "P" .. player.UserId
local rng = Random.new()
local equippedTool = nil
local holding = false
local lastFire = 0
local phase = "Waiting"
local toolConnections = {}

---------------------------------------------------------------------------
-- Interface : viseur, recharge, hitmarker, flash de dégâts
---------------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "FleurWeaponGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 5
gui.Parent = player:WaitForChild("PlayerGui")

local crosshair = Instance.new("Frame")
crosshair.Name = "Viseur"
crosshair.AnchorPoint = Vector2.new(0.5, 0.5)
crosshair.Size = UDim2.fromOffset(34, 34)
crosshair.BackgroundTransparency = 1
crosshair.Visible = false
crosshair.Parent = gui

for i = 0, 3 do
	local bar = Instance.new("Frame")
	local horizontal = i % 2 == 0
	bar.Size = if horizontal then UDim2.fromOffset(10, 3) else UDim2.fromOffset(3, 10)
	bar.AnchorPoint = Vector2.new(0.5, 0.5)
	local offsets = { Vector2.new(-11, 0), Vector2.new(0, -11), Vector2.new(11, 0), Vector2.new(0, 11) }
	bar.Position = UDim2.new(0.5, offsets[i + 1].X, 0.5, offsets[i + 1].Y)
	bar.BackgroundColor3 = Color3.new(1, 1, 1)
	bar.BorderSizePixel = 0
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 1
	stroke.Color = Color3.fromRGB(40, 60, 30)
	stroke.Parent = bar
	bar.Parent = crosshair
end

local heart = Instance.new("Frame")
heart.Size = UDim2.fromOffset(6, 6)
heart.AnchorPoint = Vector2.new(0.5, 0.5)
heart.Position = UDim2.fromScale(0.5, 0.5)
heart.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
heart.Parent = crosshair
Instance.new("UICorner", heart).CornerRadius = UDim.new(1, 0)

local cooldownBack = Instance.new("Frame")
cooldownBack.Size = UDim2.fromOffset(34, 4)
cooldownBack.Position = UDim2.new(0.5, -17, 1, 6)
cooldownBack.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
cooldownBack.BackgroundTransparency = 0.4
cooldownBack.BorderSizePixel = 0
cooldownBack.Parent = crosshair
local cooldownFill = Instance.new("Frame")
cooldownFill.Size = UDim2.fromScale(1, 1)
cooldownFill.BackgroundColor3 = Color3.fromRGB(140, 220, 90)
cooldownFill.BorderSizePixel = 0
cooldownFill.Parent = cooldownBack

local hitmarker = Instance.new("TextLabel")
hitmarker.AnchorPoint = Vector2.new(0.5, 0.5)
hitmarker.Position = UDim2.fromScale(0.5, 0.5)
hitmarker.Size = UDim2.fromOffset(60, 60)
hitmarker.BackgroundTransparency = 1
hitmarker.Text = "✿"
hitmarker.TextScaled = true
hitmarker.Font = Enum.Font.FredokaOne
hitmarker.TextColor3 = Color3.new(1, 1, 1)
hitmarker.TextTransparency = 1
hitmarker.Parent = crosshair

local damageFlash = Instance.new("Frame")
damageFlash.Size = UDim2.fromScale(1, 1)
damageFlash.BackgroundColor3 = Color3.fromRGB(255, 80, 120)
damageFlash.BackgroundTransparency = 1
damageFlash.BorderSizePixel = 0
damageFlash.ZIndex = 0
damageFlash.Parent = gui

local function playSound(id, volume)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = volume or 0.5
	s.PlaybackSpeed = 0.9 + math.random() * 0.25
	SoundService:PlayLocalSound(s)
	task.delay(2, function()
		s:Destroy()
	end)
end

---------------------------------------------------------------------------
-- Tir
---------------------------------------------------------------------------
local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude

local function getTier()
	return Config.GetTier(player:GetAttribute("FleurTier") or Config.DefaultTier)
end

local function getAimPoint(character)
	local camera = workspace.CurrentCamera
	local mouse = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	aimParams.FilterDescendantsInstances = { character, PetalVisual.GetFolder() }
	local result = workspace:Raycast(ray.Origin, ray.Direction * 1500, aimParams)
	return if result then result.Position else ray.Origin + ray.Direction * 1500
end

local function fire()
	local character = player.Character
	local tool = equippedTool
	if not character or not tool or tool.Parent ~= character or phase ~= "Round" then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local tier = getTier()
	local now = os.clock()
	if now - lastFire < tier.Cooldown then
		return -- cadence de tir (anti-spam)
	end

	local handle = tool:FindFirstChild("Handle")
	local muzzle = handle and handle:FindFirstChild("Muzzle")
	local head = character:FindFirstChild("Head")
	local origin = if muzzle then muzzle.WorldPosition elseif head then head.Position else nil
	if not origin then
		return
	end
	local direction = getAimPoint(character) - origin
	if direction.Magnitude < 0.5 then
		return
	end
	direction = direction.Unit
	lastFire = now

	for _ = 1, tier.Petals do
		local velocity = Config.ApplySpread(direction, tier.Spread, rng) * tier.Speed
		PetalVisual.Spawn(origin, velocity, player:GetAttribute("FleurFlower"), player:GetAttribute("FleurEffect"), character)
	end
	FireRequest:FireServer(origin, direction)
	playSound(Config.Sounds.Shoot, 0.35)
end

local function clearToolConnections()
	for _, c in toolConnections do
		c:Disconnect()
	end
	table.clear(toolConnections)
end

local function onToolEquipped(tool)
	clearToolConnections()
	equippedTool = tool
	table.insert(toolConnections, tool.Activated:Connect(function()
		holding = true
		fire()
	end))
	table.insert(toolConnections, tool.Deactivated:Connect(function()
		holding = false
	end))
	crosshair.Visible = true
	UserInputService.MouseIconEnabled = false
end

local function onToolUnequipped()
	clearToolConnections()
	equippedTool = nil
	holding = false
	crosshair.Visible = false
	UserInputService.MouseIconEnabled = true
end

local function hookCharacter(character)
	onToolUnequipped()
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == Config.ToolName then
			onToolEquipped(child)
		end
	end)
	character.ChildRemoved:Connect(function(child)
		if child == equippedTool then
			onToolUnequipped()
		end
	end)
	local existing = character:FindFirstChild(Config.ToolName)
	if existing then
		onToolEquipped(existing)
	end
end

player.CharacterAdded:Connect(hookCharacter)
if player.Character then
	hookCharacter(player.Character)
end

RunService.RenderStepped:Connect(function()
	if not crosshair.Visible then
		return
	end
	local mouse = UserInputService:GetMouseLocation()
	crosshair.Position = UDim2.fromOffset(mouse.X, mouse.Y)

	local tier = getTier()
	local progress = math.clamp((os.clock() - lastFire) / tier.Cooldown, 0, 1)
	cooldownFill.Size = UDim2.fromScale(progress, 1)
	heart.BackgroundColor3 = Cosmetics.Get("FlowerSkin", player:GetAttribute("FleurFlower")).HeartColor
	crosshair.Rotation = (1 - progress) * 45

	if holding then
		fire()
	end
end)

---------------------------------------------------------------------------
-- Réseau : pétales des autres, confirmations de touche
---------------------------------------------------------------------------
local function findModel(id)
	if id:sub(1, 1) == "P" then
		local other = Players:GetPlayerByUserId(tonumber(id:sub(2)) or 0)
		return other and other.Character
	end
	local folder = workspace:FindFirstChild(Config.BotsFolderName)
	if folder then
		for _, m in folder:GetChildren() do
			if m:GetAttribute("FleurId") == id then
				return m
			end
		end
	end
	return nil
end

PetalFired.OnClientEvent:Connect(function(shooterId, origin, velocities, _tierIndex, flowerId, effectId)
	if shooterId == myId then
		return -- déjà affiché localement
	end
	local model = findModel(shooterId)
	for _, v in velocities do
		PetalVisual.Spawn(origin, v, flowerId, effectId, model)
	end
end)

HitConfirm.OnClientEvent:Connect(function(_victimName, eliminated)
	hitmarker.TextColor3 = if eliminated then Color3.fromRGB(255, 70, 90) else Color3.new(1, 1, 1)
	hitmarker.TextTransparency = 0
	hitmarker.Size = UDim2.fromOffset(if eliminated then 80 else 56, if eliminated then 80 else 56)
	TweenService:Create(hitmarker, TweenInfo.new(0.35), { TextTransparency = 1 }):Play()
	playSound(Config.Sounds.Hit, if eliminated then 0.8 else 0.5)
end)

HitTaken.OnClientEvent:Connect(function()
	damageFlash.BackgroundTransparency = 0.6
	TweenService:Create(damageFlash, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
end)

GameState.OnClientEvent:Connect(function(s)
	phase = s.Phase
end)

task.spawn(function()
	local ok, s = pcall(function()
		return remotes:WaitForChild("GetState"):InvokeServer()
	end)
	if ok and s then
		phase = s.Phase
	end
end)
]]></ProtectedString></Properties></Item></Item></Item><Item class="StarterCharacterScripts" referent="RBX00000015"><Properties><string name="Name">StarterCharacterScripts</string></Properties></Item></Item><Item class="Teams" referent="RBX00000017"><Properties><string name="Name">Teams</string></Properties></Item></roblox>
