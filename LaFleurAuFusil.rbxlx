---------------------------------------------------------------------------
-- Boutique Robux : sachets de graines (Developer Products)
-- Créez chaque produit sur create.roblox.com > votre expérience >
-- Monétisation > Produits pour développeurs, fixez le prix, collez l'ID.
-- Le prix affiché en jeu est lu automatiquement chez Roblox.
---------------------------------------------------------------------------
Config.Shop = {
	StudioFreeProducts = true, -- si ProductId = 0 : dans Studio, l'achat est simulé (gratuit, pour tester)
	Products = {
		{ Key = "Sachet1", PackId = "Sachet", Count = 1, ProductId = 0, Label = "×1" },
		{ Key = "Sachet5", PackId = "Sachet", Count = 5, ProductId = 0, Label = "×5" },
		{ Key = "SachetDore1", PackId = "SachetDore", Count = 1, ProductId = 0, Label = "×1" },
		{ Key = "SachetDore5", PackId = "SachetDore", Count = 5, ProductId = 0, Label = "×5" },
	},
}

function Config.GetProduct(key)
	for _, product in Config.Shop.Products do
		if product.Key == key then
			return product
		end
	end
	return nil
end

function Config.GetProductById(productId)
	for _, product in Config.Shop.Products do
		if product.ProductId ~= 0 and product.ProductId == productId then
			return product
		end
	end
	return nil
end

-- Graines d'une partie. stats = { Won, Hits, Taken, FinalScore, Ratio, IsMVP }
function Config.ComputeSeeds(stats, hasPremium)
	local s = Config.BattlePass.Seeds
	local lines = {}
	local function add(label, amount)
		amount = math.floor(amount + 0.5)
		if amount > 0 then
			table.insert(lines, { Label = label, Amount = amount })
		end
		return amount
	end
	if stats.Hits == 0 and stats.Taken == 0 then
		return 0, lines -- inactif : rien
	end
	local total = 0
	if stats.Won then
		total += add("Victoire", s.WinBase)
	end
	total += add("Touches", stats.Hits * s.PerHit)
	total += add("Score", math.max(0, stats.FinalScore) / s.ScorePerSeed)
	total += add("Ratio", math.min(s.RatioBonusMax, stats.Ratio * s.RatioBonusPerPoint))
	if stats.IsMVP then
		total += add("MVP", s.MVPBonus)
	end
	if not stats.Won then
		local before = total
		total = math.floor(total * s.LoserShare + 0.5)
		table.insert(lines, { Label = string.format("Défaite (×%.1f)", s.LoserShare), Amount = total - before })
	end
	if hasPremium and total > 0 then
		local bonus = math.floor(total * Config.BattlePass.PremiumSeedBonus + 0.5)
		total += add("Bonus Premium", bonus)
	end
	total = math.min(total, s.MaxPerMatch)
	return total, lines
end

---------------------------------------------------------------------------
-- Sons (remplaçables par vos propres assets)
---------------------------------------------------------------------------
Config.Sounds = {
	Shoot = "rbxasset://sounds/swordslash.wav",
	Hit = "rbxasset://sounds/electronicpingshort.wav",
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Cosmetics</string><ProtectedString name="Source"><![CDATA[--[[
	La fleur au fusil — Catalogue des cosmétiques (ModuleScript partagé)
	Emplacement : ReplicatedStorage > FleurShared > Cosmetics

	Trois catégories :
	  * WeaponSkin  : couleurs/matériaux du fusil
	  * FlowerSkin  : la fleur au bout du canon (et la couleur des pétales tirés)
	  * PetalEffect : « animation » des pétales tirés (traînée, étincelles,
	                  orbite, effet d'impact…)
	Les récompenses du pass de saison (Config.BattlePass.Tiers) pointent vers
	ces Id. Pour ajouter un objet : ajoutez une entrée ici, puis référencez
	son Id dans un palier.
]]

local Cosmetics = {}

-- Order : du plus courant au plus rare ; Refund : graines rendues pour un doublon de sachet
Cosmetics.Rarities = {
	Commune = { Order = 1, Color = Color3.fromRGB(175, 185, 175), Label = "Commune", Refund = 10 },
	PeuCommune = { Order = 2, Color = Color3.fromRGB(110, 210, 110), Label = "Peu commune", Refund = 20 },
	Rare = { Order = 3, Color = Color3.fromRGB(80, 160, 255), Label = "Rare", Refund = 40 },
	Epique = { Order = 4, Color = Color3.fromRGB(190, 90, 255), Label = "Épique", Refund = 80 },
	Legendaire = { Order = 5, Color = Color3.fromRGB(255, 190, 40), Label = "Légendaire", Refund = 150 },
	Mythique = { Order = 6, Color = Color3.fromRGB(255, 70, 100), Label = "Mythique", Refund = 300 },
	Divin = { Order = 7, Color = Color3.fromRGB(255, 240, 150), Label = "Divin", Refund = 600 },
	Secret = { Order = 8, Color = Color3.fromRGB(110, 255, 230), Label = "Secret", Refund = 1200 },
	Transcendant = { Order = 9, Color = Color3.fromRGB(255, 255, 255), Label = "Secret / Transcendant", Refund = 2500 },
	Ultime = { Order = 10, Color = Color3.fromRGB(255, 120, 255), Label = "Ultime", Refund = 5000, Rainbow = true },
}
Cosmetics.RarityOrder = { "Commune", "PeuCommune", "Rare", "Epique", "Legendaire", "Mythique", "Divin", "Secret", "Transcendant", "Ultime" }

Cosmetics.TypeLabels = {
	WeaponSkin = "Skin d'arme",
	FlowerSkin = "Fleur",
	PetalEffect = "Animation de pétales",
}

---------------------------------------------------------------------------
-- Skins d'arme
--   Body : carcasse (jaune-orangé sur le modèle de base)
--   Accent : crosse, garde-main, poignée, talon du chargeur
--   Metal : canon, lunette, chargeur, rails ; Dark : fentes et détails
---------------------------------------------------------------------------
Cosmetics.WeaponSkins = {
	{ Id = "Classique", Name = "Classique", Rarity = "Commune",
		Body = Color3.fromRGB(245, 170, 40), Accent = Color3.fromRGB(240, 125, 35), Metal = Color3.fromRGB(150, 155, 165), Dark = Color3.fromRGB(80, 82, 90) },
	{ Id = "Potager", Name = "Camouflage Potager", Rarity = "Rare",
		Body = Color3.fromRGB(110, 140, 60), Accent = Color3.fromRGB(125, 90, 55), Metal = Color3.fromRGB(85, 95, 75), Dark = Color3.fromRGB(45, 50, 35) },
